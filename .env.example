# VelocityMaid Environment Variables
# Copy this file to .env.local and fill in your actual values

# DATABASE — Supabase project chsahtnpwssyfrqzcncz
# Prisma reads .env (not .env.local). Keep DATABASE_URL + DIRECT_URL in sync in both files.
# If your password contains special characters (# @ : / etc.), URL-encode them (# → %23).
#
# App queries — transaction pooler (IPv4, port 6543)
DATABASE_URL="postgresql://postgres.chsahtnpwssyfrqzcncz:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require"
# Migrations — session pooler (port 5432)
DIRECT_URL="postgresql://postgres.chsahtnpwssyfrqzcncz:[PASSWORD]@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=require"

# STRIPE
STRIPE_SECRET_KEY="sk_test_your_stripe_secret_key_here"
STRIPE_WEBHOOK_SECRET="whsec_your_webhook_secret_here"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_your_publishable_key_here"
STRIPE_PRICE_WEEKLY="price_your_weekly_price_id"
STRIPE_PRICE_BIWEEKLY="price_your_biweekly_price_id"
STRIPE_PRICE_MONTHLY="price_your_monthly_price_id"
STRIPE_BILLING_PORTAL_RETURN_URL="https://velocitymaid.com/customer/billing"

# WHATSAPP
WHATSAPP_TOKEN="your_whatsapp_access_token_here"
WHATSAPP_PHONE_NUMBER_ID="your_phone_number_id_here"
WHATSAPP_ACCESS_TOKEN="your_whatsapp_access_token_here"
WHATSAPP_PHONE_ID="your_phone_number_id_here"
WHATSAPP_API_VERSION="v19.0"
WHATSAPP_VERIFY_TOKEN="velocitymaid-webhook"
ADMIN_WHATSAPP="+18027335348"
ADMIN_TEST_PHONE="+18027335348"
WHATSAPP_TEST_PHONE="+18027335348"

# APPLICATION
NEXT_PUBLIC_BASE_URL="https://velocitymaid.com"
NODE_ENV="production"

# CRON JOBS
CRON_SECRET="your_cron_secret_here"

# SERVICE REMINDER (hours before scheduled clean; e.g. 2 = 2h before, 24 = evening before)
SERVICE_REMINDER_HOURS_BEFORE="2"

# SUBSCRIPTION RENEWAL REMINDER (days before current_period_end; e.g. 3 = 3 days before)
SUBSCRIPTION_RENEWAL_DAYS_BEFORE="3"

# LOYALTY CREDIT (after N completed jobs per branch)
LOYALTY_CREDIT_THRESHOLD="3"
LOYALTY_CREDIT_AMOUNT="20"

# WIN-BACK (inactive 45+ days)
WINBACK_OFFER="10% off your next clean"

# SEASONAL PROMO (one send per customer per campaign; run GET /api/cron/seasonal-promo?campaign=<id>)
# JSON: {"campaign-id":{"name":"...","details":"...","bookingLink":"..."}}
# SEASONAL_PROMO_CAMPAIGNS={"spring-2025":{"name":"Spring Clean 2025","details":"20% off deep cleans.","bookingLink":"https://velocitymaid.com/book?branch=new-jersey"}}

# PRICE CHANGE NOTICE (one send per customer per change; run GET /api/cron/price-change-notice?changeId=<id>)
# JSON: {"change-id":{"effectiveDate":"March 1, 2025","pricingLink":"https://...","branchId":"optional"}}
# PRICE_CHANGE_NOTICES={"spring-2025":{"effectiveDate":"March 1, 2025","pricingLink":"https://velocitymaid.com/pricing","branchId":"branch-id"}}

# GOOGLE ANALYTICS
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# GOOGLE BUSINESS PROFILE
GBP_LOCATION_ID="your_gbp_location_id"

# CALENDLY
NEXT_PUBLIC_CALENDLY_USERNAME="velocitymaid"
NEXT_PUBLIC_CALENDLY_EVENT="jamaica-cleaner-interview"

# GOOGLE REVIEWS
NEXT_PUBLIC_NJ_GOOGLE_REVIEW_URL="https://g.page/r/your_google_review_url"

# CURRENCY
JMD_USD_EXCHANGE_RATE="0.0064"

# INTEGRATIONS
ZAPIER_WEBHOOK_URL="https://hooks.zapier.com/hooks/catch/your_webhook_id"
ADMIN_WEBHOOK_URL="https://your-webhook-url.com"
