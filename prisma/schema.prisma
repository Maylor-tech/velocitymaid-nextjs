generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Branch {
  id                                String                      @id
  name                              String
  slug                              String                      @unique
  country                           String                      @default("US")
  state                             String
  city                              String
  regionLabel                       String?
  timezone                          String
  primaryPhone                      String
  whatsappNumber                    String
  managerId                         String?
  pricingModelId                    String?
  status                            BranchStatus                @default(COMING_SOON)
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime
  currency                          String                      @default("USD")
  User_Branch_managerIdToUser       User?                       @relation("Branch_managerIdToUser", fields: [managerId], references: [id])
  PricingModel                      PricingModel?               @relation(fields: [pricingModelId], references: [id])
  BranchAutomationConfig            BranchAutomationConfig?
  BranchConfig                      BranchConfig?
  BranchLandingContent              BranchLandingContent?
  BranchOnboardingResources         BranchOnboardingResources[]
  BranchPayoutRules                 BranchPayoutRules?
  BranchServiceArea                 BranchServiceArea[]
  BranchServicePackage              BranchServicePackage[]
  BranchSops                        BranchSops[]
  CleanerApplication                CleanerApplication[]
  Customer                          Customer[]
  JamaicaPayout                     JamaicaPayout[]
  Job                               Job[]
  Lead                              Lead[]
  NurtureSequence                   NurtureSequence[]
  Promo                             Promo[]
  ReferralEvent                     ReferralEvent[]
  ReferralLink                      ReferralLink[]
  TransactionLedger                 TransactionLedger[]
  User_User_primaryBranchIdToBranch User[]                      @relation("User_primaryBranchIdToBranch")
  UserBranch                        UserBranch[]
  AssignmentLog                    AssignmentLog[]
  ServicePricing                    ServicePricing[]
  RegionPricingModifier             RegionPricingModifier[]

  @@index([managerId])
  @@index([pricingModelId])
  @@index([slug])
  @@index([status])
}

model BranchAutomationConfig {
  id                       String   @id
  branchId                 String   @unique
  bookingWebhookUrl        String?
  reminderWebhookUrl       String?
  reviewWebhookUrl         String?
  whatsappTemplateBooking  String?
  whatsappTemplateReminder String?
  whatsappTemplateReview   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  Branch                   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchConfig {
  id                     String   @id
  branchId               String   @unique
  bookingEmail           String?
  supportEmail           String?
  maxDailyJobs           Int?
  whatsappTemplateConfig Json?
  zapierHooks            Json?
  operationsFlags        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  Branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchLandingContent {
  id             String   @id
  branchId       String   @unique
  headline       String?
  subheadline    String?
  heroImageUrl   String?
  localCtaLabel  String?
  seoTitle       String?
  seoDescription String?
  testimonials   Json?
  faqEntries     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  cityContent    Json?
  Branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchOnboardingResources {
  id          String   @id
  branchId    String
  name        String
  description String?
  resourceUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model BranchPayoutRules {
  id                     String       @id
  branchId               String       @unique
  baseRateType           BaseRateType
  baseRateValue          Decimal      @db.Decimal(10, 2)
  overtimeRules          Json?
  tipHandling            TipHandling
  franchiseFeePercentage Decimal?     @db.Decimal(5, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  Branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchServiceArea {
  id        String   @id
  branchId  String
  zipCode   String
  priority  Int      @default(1)
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, zipCode])
  @@index([branchId])
  @@index([zipCode])
  @@index([zipCode, priority])
}

model BranchServicePackage {
  id                   String   @id
  branchId             String
  code                 String
  name                 String
  description          String?
  defaultDurationHours Int
  basePrice            Decimal  @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  currency             String?  @default("USD")
  pricingData          Json?
  Branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, isActive])
}

model BranchSops {
  id        String      @id
  branchId  String
  category  SopCategory
  title     String
  docUrl    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  Branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, category])
  @@index([branchId])
}

model CleanerApplication {
  id                  String                   @id
  name                String
  email               String
  phone               String
  branchId            String
  experienceLevel     String?
  daysAvailable       Json?
  notes               String?
  status              CleanerApplicationStatus @default(PENDING)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime
  applicantFitScore   Int?
  areaOfResidence     String?
  canTravelToVillas   Boolean                  @default(false)
  idUploadUrl         String?
  referencesUploadUrl String?
  weekendAbility      Boolean                  @default(false)
  whatsappNumber      String?
  Branch              Branch                   @relation(fields: [branchId], references: [id])

  @@index([applicantFitScore])
  @@index([branchId])
  @@index([email])
  @@index([status])
}

model CleanerAvailability {
  id            String   @id
  cleanerId     String   @unique
  workingDays   Json
  timeRanges    Json
  maxDailyJobs  Int      @default(3)
  blackoutDates Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  User          User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([isActive])
}

model CleanerPaymentMethod {
  id               String    @id @default(uuid())
  cleanerId        String
  methodType       String
  label            String?
  details          Json
  isActive         Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  verifiedAt       DateTime?
  verifiedBy       String?
  verificationNote String?
  User             User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId, isActive])
  @@index([cleanerId])
}

model Contract {
  id        String    @id
  name      String
  type      String
  branch    String    @default("port-antonio")
  url       String
  status    String    @default("PENDING")
  signedAt  DateTime?
  signedBy  String?
  phone     String?
  email     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  @@index([branch])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model Customer {
  id                                                       String           @id @default(uuid())
  firstName                                                String
  lastName                                                 String
  email                                                    String           @unique
  phone                                                    String?
  defaultAddress                                           String?
  homeZipCode                                              String?
  branchId                                                 String?
  stripeCustomerId                                         String?          @unique
  loyaltyPoints                                            Int              @default(0)
  createdAt                                                DateTime         @default(now())
  updatedAt                                                DateTime
  preferSameCleaner                                        Boolean          @default(false)
  leadStatus                                               LeadStatus       @default(NEW)
  whatsappOptIn                                            Boolean          @default(false)
  Branch                                                   Branch?          @relation(fields: [branchId], references: [id])
  Job                                                      Job[]
  NurtureHistory                                           NurtureHistory[]
  NurtureSequence                                          NurtureSequence?
  ReferralCredit                                           ReferralCredit[]
  ReferralEvent_ReferralEvent_referredCustomerIdToCustomer ReferralEvent[]  @relation("ReferralEvent_referredCustomerIdToCustomer")
  ReferralEvent_ReferralEvent_referrerIdToCustomer         ReferralEvent[]  @relation("ReferralEvent_referrerIdToCustomer")
  ReferralLink                                             ReferralLink[]
  CleanerRating                                            CleanerRating[]

  @@index([branchId])
  @@index([email])
  @@index([homeZipCode])
  @@index([leadStatus])
}

model FranchiseApplication {
  id                      String                     @id
  name                    String
  email                   String
  phone                   String
  city                    String
  state                   String
  country                 String
  desiredBranchSlug       String?
  background              String?
  investmentCapacityRange String?
  notes                   String?
  status                  FranchiseApplicationStatus @default(PENDING)
  internalNotes           String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime

  @@index([city, state])
  @@index([email])
  @@index([status])
}

model JamaicaPaymentMethod {
  id             String   @id
  cleanerId      String   @unique
  bankName       String?
  accountNumber  String?
  accountType    String?
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
}

model JamaicaPayout {
  id            String   @id
  cleanerId     String
  branchId      String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  currency      String   @default("JMD")
  status        String   @default("PENDING")
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User          User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([cleanerId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model Job {
  id                  String    @id @default(uuid())
  sessionId           String?   @unique
  branchId            String
  customerId          String?
  assignedCleanerId   String?
  customerName        String?
  preferredDate       DateTime?
  preferredTime       String?
  serviceType         String?
  serviceLocation     String?
  address             String?
  status              JobStatus @default(RECEIVED)
  totalPrice          Decimal?  @db.Decimal(10, 2)
  createdAt           DateTime  @default(now())
  assignedAt          DateTime?
  onTheWayAt          DateTime?
  completedAt         DateTime?
  currency            String?   @default("USD")
  paymentMethod       String?
  jobQualityScore     Int?
  appliedReferralCode String?
  promoApplied        String?
  promoDiscount       Decimal?  @db.Decimal(10, 2)
  // Phase L: Pricing Lock & Snapshot
  // NOTE: Pricing fields removed - database schema is source of truth
  // These fields do not exist in database and should not be referenced
  // priceLockedAt       DateTime?
  // pricingSnapshot     Json?
  // pricingReferenceId String?
  // basePrice           Decimal?
  // modifiers           Decimal?
  // fees                Decimal?
  // tax                 Decimal?
  // discountAmount      Decimal?
  // discountReason      String?
  // discountApprovedBy  String?
  User                User?     @relation(fields: [assignedCleanerId], references: [id])
  Branch              Branch    @relation(fields: [branchId], references: [id])
  Customer            Customer? @relation(fields: [customerId], references: [id])
  AssignmentLog       AssignmentLog[]
  CleanerRating       CleanerRating?

  @@index([appliedReferralCode])
  // @@index([priceLockedAt])  // Commented out until column exists in database
  @@index([assignedCleanerId])
  @@index([branchId])
  @@index([customerId])
  @@index([jobQualityScore])
  @@index([preferredDate])
  @@index([status])
}

model AssignmentLog {
  id          String   @id @default(cuid())
  jobId       String
  cleanerId   String?
  branchId    String
  outcome     String   // "ASSIGNED" | "NO_CLEANER" | "SKIPPED"
  reason      String?
  details     Json?
  createdAt   DateTime @default(now())
  Job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  Branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([branchId])
  @@index([createdAt])
}

model CleanerRating {
  id          String   @id @default(cuid())
  jobId       String   @unique
  cleanerId   String
  customerId  String?
  rating      Int
  comment     String?
  createdAt   DateTime @default(now())
  Job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  Cleaner     User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  Customer    Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
}

model Lead {
  id                String     @id
  branchId          String
  name              String
  phone             String
  email             String?
  zip               String?
  bedrooms          Int?
  bathrooms         Int?
  pets              Boolean    @default(false)
  homeType          String?
  urgency           String?
  previousService   Boolean    @default(false)
  referralSource    String?
  leadScore         Int        @default(0)
  leadTier          String     @default("C")
  riskFlags         String[]   @default([])
  status            LeadStatus @default(NEW)
  depositPaid       Boolean    @default(false)
  depositUrl        String?
  customerId        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  afterHoursMessage String?
  waitForMorning    Boolean    @default(false)
  Branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([email])
  @@index([leadScore])
  @@index([leadTier])
  @@index([phone])
  @@index([status])
  @@index([waitForMorning])
  @@index([zip])
}

model LessonProgress {
  id             String         @id
  cleanerId      String
  lessonId       String
  status         String         @default("NOT_STARTED")
  score          Int?
  completedAt    DateTime?
  User           User           @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  TrainingLesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, lessonId])
  @@index([cleanerId])
  @@index([lessonId])
  @@index([status])
}

model NurtureHistory {
  id                String               @id
  customerId        String
  nurtureSequenceId String?
  day               Int
  message           String
  channel           NurtureChannel
  status            NurtureMessageStatus @default(PENDING)
  messageId         String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  Customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  NurtureSequence   NurtureSequence?     @relation(fields: [nurtureSequenceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([day])
  @@index([nurtureSequenceId])
  @@index([status])
}

model NurtureSequence {
  id             String           @id
  customerId     String           @unique
  branchId       String
  isActive       Boolean          @default(true)
  currentDay     Int              @default(0)
  startedAt      DateTime         @default(now())
  pausedAt       DateTime?
  completedAt    DateTime?
  referralCode   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  NurtureHistory NurtureHistory[]
  Branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([customerId])
  @@index([isActive])
}

model PricingModel {
  id            String      @id
  name          String
  billingType   BillingType
  currency      String      @default("USD")
  baseRate      Decimal     @db.Decimal(10, 2)
  extraHourRate Decimal?    @db.Decimal(10, 2)
  minHours      Int?
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Branch        Branch[]

  @@index([name])
}

model Promo {
  id            String   @id
  branchId      String
  month         Int
  year          Int
  title         String
  description   String
  discountType  String
  discountValue Int
  active        Boolean  @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month, year])
  @@index([active])
  @@index([branchId])
  @@index([month, year])
  @@index([startDate, endDate])
}

model ReferralCredit {
  id             String               @id
  customerId     String
  referralLinkId String?
  amount         Decimal              @db.Decimal(10, 2)
  status         ReferralCreditStatus @default(PENDING)
  appliedToJobId String?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime
  Customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ReferralLink   ReferralLink?        @relation(fields: [referralLinkId], references: [id])

  @@index([customerId])
  @@index([referralLinkId])
  @@index([status])
}

model ReferralEvent {
  id                                                  String              @id
  referrerId                                          String
  referredCustomerId                                  String
  branchId                                            String
  referralLinkId                                      String?
  jobId                                               String?
  status                                              ReferralEventStatus @default(PENDING)
  referrerCreditId                                    String?
  referredDiscountApplied                             Boolean             @default(false)
  createdAt                                           DateTime            @default(now())
  updatedAt                                           DateTime
  Branch                                              Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ReferralLink                                        ReferralLink?       @relation(fields: [referralLinkId], references: [id])
  Customer_ReferralEvent_referredCustomerIdToCustomer Customer            @relation("ReferralEvent_referredCustomerIdToCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  Customer_ReferralEvent_referrerIdToCustomer         Customer            @relation("ReferralEvent_referrerIdToCustomer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([referralLinkId])
  @@index([referredCustomerId])
  @@index([referrerId])
  @@index([status])
}

model ReferralLink {
  id             String           @id
  customerId     String
  branchId       String
  code           String           @unique
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ReferralCredit ReferralCredit[]
  ReferralEvent  ReferralEvent[]
  Branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([code])
  @@index([customerId])
}

model TrainingCertificate {
  id                     String         @id
  certificateId          String         @unique
  cleanerId              String         @unique
  status                 String         @default("ACTIVE")
  issuedAt               DateTime       @default(now())
  revokedAt              DateTime?
  statusRelation         TrainingStatus @relation(fields: [cleanerId], references: [cleanerId], onDelete: Cascade, map: "TrainingCertificate_cleanerId_TrainingStatus_fkey")
  userRelation           User           @relation(fields: [cleanerId], references: [id], onDelete: Cascade, map: "TrainingCertificate_cleanerId_User_fkey")

  @@index([certificateId])
  @@index([cleanerId])
  @@index([status])
}

model TrainingLesson {
  id             String           @id
  moduleId       String
  title          String
  content        String
  order          Int
  quizJson       Json?
  LessonProgress LessonProgress[]
  TrainingModule TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  TrainingQuiz   TrainingQuiz?

  @@index([moduleId])
  @@index([moduleId, order])
}

model TrainingModule {
  id             String           @id
  slug           String           @unique
  title          String
  description    String
  order          Int
  isActive       Boolean          @default(true)
  TrainingLesson TrainingLesson[]

  @@index([isActive])
  @@index([order])
  @@index([slug])
}

model TrainingQuestion {
  id            String       @id
  quizId        String
  question      String
  order         Int
  questionType  String       @default("MULTIPLE_CHOICE")
  options       Json
  correctAnswer Int
  explanation   String?
  TrainingQuiz  TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, order])
}

model TrainingQuiz {
  id                  String                @id
  lessonId            String                @unique
  title               String
  passingScore        Int                   @default(70)
  timeLimit           Int?
  isActive            Boolean               @default(true)
  TrainingQuestion    TrainingQuestion[]
  TrainingLesson      TrainingLesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  TrainingQuizAttempt TrainingQuizAttempt[]

  @@index([isActive])
  @@index([lessonId])
}

model TrainingQuizAttempt {
  id           String       @id
  cleanerId    String
  quizId       String
  lessonId     String
  score        Int
  passed       Boolean
  answers      Json
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  User         User         @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  TrainingQuiz TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([lessonId])
  @@index([passed])
  @@index([quizId])
  @@index([startedAt])
}

model TrainingStatus {
  id                  String               @id
  cleanerId           String               @unique
  overallStatus       String               @default("NOT_STARTED")
  lastModuleSlug      String?
  updatedAt           DateTime
  TrainingCertificate TrainingCertificate?
  User                User                 @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([overallStatus])
}

model TransactionLedger {
  id              String   @id
  branchId        String?
  transactionType String
  amount          Float
  currency        String   @default("JMD")
  description     String?
  referenceId     String?
  referenceType   String?
  cleanerId       String?
  customerId      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  Branch          Branch?  @relation(fields: [branchId], references: [id])
  User            User?    @relation(fields: [cleanerId], references: [id])

  @@index([branchId])
  @@index([cleanerId])
  @@index([createdAt])
  @@index([customerId])
  @@index([referenceId, referenceType])
  @@index([transactionType])
}

model User {
  id                                  String                @id
  email                               String                @unique
  name                                String?
  role                                UserRole              @default(CLEANER)
  primaryBranchId                     String?
  createdAt                           DateTime              @default(now())
  updatedAt                           DateTime
  isActive                            Boolean               @default(false)
  homeZip                             String?
  preferredCities                     String[]              @default([])
  Branch_Branch_managerIdToUser       Branch[]              @relation("Branch_managerIdToUser")
  CleanerAvailability                 CleanerAvailability?
  CleanerPaymentMethod                CleanerPaymentMethod[]
  JamaicaPaymentMethod                JamaicaPaymentMethod?
  JamaicaPayout                       JamaicaPayout[]
  Job                                 Job[]
  LessonProgress                      LessonProgress[]
  TrainingCertificate                 TrainingCertificate?
  TrainingQuizAttempt                 TrainingQuizAttempt[]
  TrainingStatus                      TrainingStatus?
  TransactionLedger                   TransactionLedger[]
  Branch_User_primaryBranchIdToBranch Branch?               @relation("User_primaryBranchIdToBranch", fields: [primaryBranchId], references: [id])
  UserBranch                          UserBranch[]
  CleanerRating                       CleanerRating[]

  @@index([isActive])
  @@index([preferredCities])
  @@index([primaryBranchId])
  @@index([role])
}

model UserBranch {
  id        String   @id
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  Branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([userId])
}

model VillaPartnerApplication {
  id                String   @id
  propertyName      String
  managerName       String
  whatsapp          String
  bedrooms          Int
  bathrooms         Int
  turnoverFrequency String
  needsInventory    Boolean  @default(false)
  needsLinenService Boolean  @default(false)
  notes             String?
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([createdAt])
  @@index([status])
}

enum BaseRateType {
  PER_HOUR
  PER_JOB
  PERCENTAGE
