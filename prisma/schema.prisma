// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// EXISTING MODELS (Extended for Branch Support)
// ============================================

model User {
  id              String   @id @default(uuid())
  email           String   @unique
  name            String?
  role            UserRole @default(CLEANER)
  isActive        Boolean  @default(false) // For cleaners: true when training passed
  primaryBranchId String?
  primaryBranch   Branch?  @relation("UserPrimaryBranch", fields: [primaryBranchId], references: [id])
  managedBranches Branch[] @relation("BranchManager")
  userBranches    UserBranch[]
  jamaicaPayouts  JamaicaPayout[] @relation("CleanerPayouts")
  jamaicaPaymentMethod JamaicaPaymentMethod?
  lessonProgresses LessonProgress[]
  trainingStatus  TrainingStatus?
  certificate     TrainingCertificate? @relation("CleanerCertificate")
  quizAttempts    TrainingQuizAttempt[]
  availability    CleanerAvailability?
  assignedJobs    Job[]                @relation("AssignedJobs")
  transactions    TransactionLedger[]
  preferredCities String[]              @default([]) // Preferred cities for job assignment
  homeZip         String?               // Cleaner's home ZIP for distance calculation
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([primaryBranchId])
  @@index([role])
  @@index([isActive])
  @@index([preferredCities])
}

model UserBranch {
  id       String @id @default(uuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Customer {
  id               String    @id @default(uuid())
  firstName        String
  lastName         String
  email            String    @unique
  phone            String?
  defaultAddress   String?
  homeZipCode      String?
  branchId         String?
  branch           Branch?   @relation(fields: [branchId], references: [id])
  stripeCustomerId String?   @unique
  loyaltyPoints    Int       @default(0)
  preferSameCleaner Boolean  @default(false) // For recurring customer logic
  leadStatus       LeadStatus @default(NEW) // NEW → ACTIVE → BOOKED → CLOSED
  whatsappOptIn    Boolean   @default(false) // WhatsApp opt-in status
  nurtureSequence  NurtureSequence?
  nurtureHistory   NurtureHistory[]
  jobs             Job[]
  referralLinks    ReferralLink[] @relation("CustomerReferralLinks")
  referralCredits  ReferralCredit[] @relation("CustomerReferralCredits")
  referrerEvents   ReferralEvent[] @relation("ReferrerEvents")
  referredEvents   ReferralEvent[] @relation("ReferredCustomerEvents")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([email])
  @@index([branchId])
  @@index([homeZipCode])
  @@index([leadStatus])
}

// ============================================
// BRANCH MODELS
// ============================================

model Branch {
  id              String            @id @default(uuid())
  name            String
  slug            String            @unique
  country         String   @default("US") // US or JM
  state           String
  city            String
  regionLabel     String?
  timezone        String
  primaryPhone    String
  whatsappNumber  String
  currency        String            @default("USD") // USD or JMD
  managerId       String?
  manager         User?             @relation("BranchManager", fields: [managerId], references: [id])
  pricingModelId String?
  pricingModel    PricingModel?     @relation(fields: [pricingModelId], references: [id])
  status          BranchStatus      @default(COMING_SOON)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  // Relations
  serviceAreas         BranchServiceArea[]
  servicePackages      BranchServicePackage[]
  config               BranchConfig?
  automationConfig     BranchAutomationConfig?
  landingContent       BranchLandingContent?
  payoutRules          BranchPayoutRules?
  sops                 BranchSops[]
  onboardingResources  BranchOnboardingResources[]
  customers            Customer[]
  jobs                 Job[]
  userBranches         UserBranch[]
  primaryUsers         User[]              @relation("UserPrimaryBranch")
  cleanerApplications  CleanerApplication[]
  jamaicaPayouts       JamaicaPayout[]
  transactions         TransactionLedger[]
  referralLinks        ReferralLink[] @relation("BranchReferralLinks")
  referralEvents       ReferralEvent[] @relation("BranchReferralEvents")
  nurtureSequences     NurtureSequence[]
  promos               Promo[]
  leads                Lead[]

  @@index([slug])
  @@index([status])
  @@index([managerId])
  @@index([pricingModelId])
}

model BranchServiceArea {
  id        String   @id @default(uuid())
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  zipCode   String
  priority  Int      @default(1)
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([branchId, zipCode])
  @@index([branchId])
  @@index([zipCode])
  @@index([zipCode, priority])
}

model PricingModel {
  id           String    @id @default(uuid())
  name         String
  billingType  BillingType
  currency     String    @default("USD")
  baseRate     Decimal   @db.Decimal(10, 2)
  extraHourRate Decimal? @db.Decimal(10, 2)
  minHours     Int?
  internalNotes String?  @db.Text
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  branches Branch[]

  @@index([name])
}

model BranchServicePackage {
  id                  String   @id @default(uuid())
  branchId            String
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  code                String
  name                String
  description         String?  @db.Text
  defaultDurationHours Int
  basePrice           Decimal  @db.Decimal(10, 2)
  currency            String?  @default("USD") // USD, JMD, etc.
  pricingData         Json?    // Multi-currency pricing, add-ons, etc. (for Port Antonio)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, isActive])
}

model BranchConfig {
  id                  String   @id @default(uuid())
  branchId            String   @unique
  branch              Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingEmail        String?
  supportEmail        String?
  maxDailyJobs        Int?
  whatsappTemplateConfig Json?
  zapierHooks         Json?
  operationsFlags     Json?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
}

model BranchAutomationConfig {
  id                    String   @id @default(uuid())
  branchId              String   @unique
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  bookingWebhookUrl     String?
  reminderWebhookUrl    String?
  reviewWebhookUrl      String?
  whatsappTemplateBooking String?
  whatsappTemplateReminder String?
  whatsappTemplateReview   String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BranchLandingContent {
  id            String   @id @default(uuid())
  branchId      String   @unique
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  headline      String?  @db.Text
  subheadline   String?  @db.Text
  heroImageUrl  String?
  localCtaLabel String?
  seoTitle      String?
  seoDescription String? @db.Text
  testimonials  Json?
  faqEntries    Json?
  cityContent   Json?    // City-specific content: { "jersey-city": {...}, "hoboken": {...} }
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model BranchPayoutRules {
  id                    String   @id @default(uuid())
  branchId              String   @unique
  branch                Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  baseRateType          BaseRateType
  baseRateValue         Decimal  @db.Decimal(10, 2)
  overtimeRules         Json?
  tipHandling           TipHandling
  franchiseFeePercentage Decimal? @db.Decimal(5, 2)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
}

model BranchSops {
  id        String      @id @default(uuid())
  branchId  String
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  category  SopCategory
  title     String
  docUrl    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([branchId])
  @@index([branchId, category])
}

model BranchOnboardingResources {
  id          String   @id @default(uuid())
  branchId    String
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  resourceUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([branchId])
}

// ============================================
// JOB/BOOKING MODEL (Extended)
// ============================================

model Job {
  id                String   @id @default(uuid())
  sessionId         String?  @unique
  branchId           String
  branch             Branch   @relation(fields: [branchId], references: [id])
  customerId         String?
  customer           Customer? @relation(fields: [customerId], references: [id])
  assignedCleanerId  String?
  assignedCleaner    User?    @relation("AssignedJobs", fields: [assignedCleanerId], references: [id])
  customerName       String?
  preferredDate      DateTime?
  preferredTime      String?
  serviceType        String?
  serviceLocation    String?
  address            String?
  status             String   @default("pending") // pending, ACCEPTED, DECLINED, assigned, in_progress, completed, cancelled
  totalPrice         Decimal? @db.Decimal(10, 2)
  currency           String?  @default("USD") // USD, JMD, etc.
  paymentMethod      String?  // "stripe", "cash", "bank_transfer", "manual"
  jobQualityScore    Int?     // Job Quality Score (0-100)
  appliedReferralCode String? // Referral code applied to this booking
  promoApplied       String?  // Promo code applied (e.g., "1-2024")
  promoDiscount      Decimal? @db.Decimal(10, 2) // Discount amount from promo
  createdAt          DateTime @default(now())
  assignedAt         DateTime?
  onTheWayAt         DateTime?
  completedAt        DateTime?

  @@index([branchId])
  @@index([assignedCleanerId])
  @@index([customerId])
  @@index([status])
  @@index([preferredDate])
  @@index([jobQualityScore])
  @@index([appliedReferralCode])
}

// ============================================
// ENUMS
// ============================================

enum UserRole {
  ADMIN
  MANAGER
  CLEANER
  SUPPORT
}

enum BranchStatus {
  ACTIVE
  COMING_SOON
  PAUSED
}

enum BillingType {
  HOURLY
  FLAT
  TIERED
}

enum BaseRateType {
  PER_HOUR
  PER_JOB
  PERCENTAGE
}

enum TipHandling {
  PASS_THROUGH
  SPLIT
  POOL
}

enum SopCategory {
  OPS
  SALES
  QC
  COMPLIANCE
}

// ============================================
// APPLICATION MODELS
// ============================================

model CleanerApplication {
  id              String   @id @default(uuid())
  name            String
  email           String
  phone           String
  whatsappNumber  String?  // WhatsApp number (876 format)
  branchId        String
  branch          Branch   @relation(fields: [branchId], references: [id])
  experienceLevel String?  // None / Moderate / Experienced
  areaOfResidence String?  // Area of residence
  daysAvailable   Json?    // Array of day names or availability object
  weekendAbility  Boolean  @default(false) // Can work weekends
  canTravelToVillas Boolean @default(false) // Can travel to villa areas
  idUploadUrl     String?  // URL to uploaded ID document
  referencesUploadUrl String? // URL to uploaded references
  applicantFitScore Int?   // Calculated fit score (0-100)
  status          CleanerApplicationStatus @default(PENDING)
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([email])
  @@index([applicantFitScore])
}

model FranchiseApplication {
  id                    String   @id @default(uuid())
  name                  String
  email                 String
  phone                 String
  city                  String
  state                 String
  country               String
  desiredBranchSlug     String?
  background            String?  @db.Text
  investmentCapacityRange String?
  notes                 String?  @db.Text
  status                FranchiseApplicationStatus @default(PENDING)
  internalNotes         String?  @db.Text
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@index([status])
  @@index([email])
  @@index([city, state])
}

enum CleanerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FranchiseApplicationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

model VillaPartnerApplication {
  id                String   @id @default(cuid())
  propertyName      String
  managerName       String
  whatsapp          String
  bedrooms          Int
  bathrooms         Int
  turnoverFrequency String   // Daily, Weekly, Seasonal
  needsInventory    Boolean  @default(false)
  needsLinenService Boolean  @default(false)
  notes             String?  @db.Text
  status            String   @default("NEW") // NEW, CONTACTED, TRIAL, ACTIVE, REJECTED
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Contract {
  id          String   @id @default(cuid())
  name        String
  type        String   // CLEANER, CUSTOMER, VILLA
  branch      String   @default("port-antonio")
  url         String   // PDF URL in Supabase Storage
  status      String   @default("PENDING") // PENDING, SIGNED
  signedAt    DateTime?
  signedBy    String?  // Name of signer
  phone       String?
  email       String?
  metadata    Json?    // Additional contract data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([branch])
  @@index([createdAt])
}

// ============================================
// JAMAICA PAYOUT MODELS
// ============================================

model JamaicaPayout {
  id            String   @id @default(cuid())
  cleanerId     String
  branchId      String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  currency      String   @default("JMD")
  status        String   @default("PENDING") // PENDING, APPROVED, PAID
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cleaner User  @relation("CleanerPayouts", fields: [cleanerId], references: [id], onDelete: Cascade)
  branch  Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([branchId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

// ============================================
// FINANCIAL MODELS
// ============================================

model TransactionLedger {
  id              String   @id @default(cuid())
  branchId        String?
  transactionType String   // PAYMENT_RECEIVED, PAYOUT_PAID, BONUS_ISSUED, REFUND, CASH_RECEIPT, BANK_TRANSFER
  amount          Float
  currency        String   @default("JMD") // JMD or USD
  description     String?  @db.Text
  referenceId     String?  // Job ID, Payout ID, etc.
  referenceType   String?  // JOB, PAYOUT, BONUS, etc.
  cleanerId       String?  // For payouts/bonuses
  customerId      String?  // For payments/refunds
  metadata        Json?    // Additional data
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  branch    Branch?  @relation(fields: [branchId], references: [id], onDelete: SetNull)
  cleaner   User?    @relation(fields: [cleanerId], references: [id], onDelete: SetNull)

  @@index([branchId])
  @@index([cleanerId])
  @@index([customerId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([referenceId, referenceType])
}

model JamaicaPaymentMethod {
  id            String   @id @default(cuid())
  cleanerId     String   @unique
  bankName      String?
  accountNumber String?
  accountType   String?  // SAVINGS / CHECKING
  whatsappNumber String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cleaner User  @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
}

// ============================================
// TRAINING MODELS
// ============================================

model TrainingModule {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  order       Int
  isActive    Boolean          @default(true)
  lessons     TrainingLesson[]

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

model TrainingLesson {
  id          String           @id @default(cuid())
  moduleId    String
  title       String
  content     String           @db.Text // markdown or rich text
  order       Int
  quizJson    Json?            // quiz questions & answers

  module      TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  progresses  LessonProgress[]
  quiz        TrainingQuiz?

  @@index([moduleId])
  @@index([moduleId, order])
}

model LessonProgress {
  id          String          @id @default(cuid())
  cleanerId   String
  lessonId    String
  status      String          @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, COMPLETED
  score       Int?
  completedAt DateTime?

  cleaner     User            @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  lesson      TrainingLesson  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, lessonId])
  @@index([cleanerId])
  @@index([lessonId])
  @@index([status])
}

model TrainingStatus {
  id             String   @id @default(cuid())
  cleanerId      String   @unique
  overallStatus  String   @default("NOT_STARTED") // NOT_STARTED, IN_PROGRESS, PASSED
  lastModuleSlug String?
  updatedAt      DateTime @updatedAt

  cleaner        User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  certificate    TrainingCertificate? @relation("TrainingStatusCertificate")

  @@index([cleanerId])
  @@index([overallStatus])
}

// ============================================
// CERTIFICATION MODELS
// ============================================

model TrainingCertificate {
  id          String   @id @default(cuid())
  certificateId String @unique // Public-facing ID for verification
  cleanerId   String   @unique
  status      String   @default("ACTIVE") // ACTIVE, REVOKED
  issuedAt    DateTime @default(now())
  revokedAt   DateTime?

  cleaner     User     @relation("CleanerCertificate", fields: [cleanerId], references: [id], onDelete: Cascade, map: "TrainingCertificate_cleanerId_User_fkey")
  trainingStatus TrainingStatus @relation("TrainingStatusCertificate", fields: [cleanerId], references: [cleanerId], onDelete: Cascade, map: "TrainingCertificate_cleanerId_TrainingStatus_fkey")

  @@index([certificateId])
  @@index([cleanerId])
  @@index([status])
}

// ============================================
// QUIZ MODELS (Enhanced)
// ============================================

model TrainingQuiz {
  id          String           @id @default(cuid())
  lessonId    String           @unique
  title       String
  passingScore Int             @default(70) // Percentage required to pass
  timeLimit   Int?             // Optional time limit in minutes
  isActive    Boolean          @default(true)

  lesson      TrainingLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  questions   TrainingQuestion[]
  attempts    TrainingQuizAttempt[]

  @@index([lessonId])
  @@index([isActive])
}

model TrainingQuestion {
  id          String           @id @default(cuid())
  quizId      String
  question    String
  order       Int
  questionType String          @default("MULTIPLE_CHOICE") // MULTIPLE_CHOICE, TRUE_FALSE
  options     Json             // Array of answer options
  correctAnswer Int            // Index of correct answer
  explanation String?          @db.Text // Explanation shown after answering

  quiz        TrainingQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, order])
}

model TrainingQuizAttempt {
  id          String           @id @default(cuid())
  cleanerId   String
  quizId      String
  lessonId    String
  score       Int              // Percentage score
  passed      Boolean
  answers     Json             // User's answers
  startedAt   DateTime         @default(now())
  completedAt DateTime?

  cleaner     User             @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  quiz        TrainingQuiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([quizId])
  @@index([lessonId])
  @@index([passed])
  @@index([startedAt])
}

// ============================================
// SCHEDULING MODELS
// ============================================

model CleanerAvailability {
  id              String   @id @default(uuid())
  cleanerId       String   @unique
  workingDays     Json     // Array of day names: ["monday", "tuesday", ...]
  timeRanges      Json     // Array of { start: "09:00", end: "17:00" } objects
  maxDailyJobs    Int      @default(3) // Maximum jobs per day
  blackoutDates   Json?    // Array of ISO date strings for unavailable dates
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  cleaner         User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([isActive])
}

// ============================================
// REFERRAL MODELS
// ============================================

model ReferralLink {
  id          String   @id @default(uuid())
  customerId String
  customer   Customer @relation("CustomerReferralLinks", fields: [customerId], references: [id], onDelete: Cascade)
  branchId   String
  branch     Branch   @relation("BranchReferralLinks", fields: [branchId], references: [id], onDelete: Cascade)
  code       String   @unique // Format: NJ-{customerId} or similar
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  referralCredits ReferralCredit[]
  referralEvents  ReferralEvent[]

  @@index([customerId])
  @@index([branchId])
  @@index([code])
}

model ReferralCredit {
  id          String       @id @default(uuid())
  customerId  String
  customer    Customer     @relation("CustomerReferralCredits", fields: [customerId], references: [id], onDelete: Cascade)
  referralLinkId String?
  referralLink ReferralLink? @relation(fields: [referralLinkId], references: [id])
  amount      Decimal      @db.Decimal(10, 2) // Credit amount (e.g., $20)
  status      ReferralCreditStatus @default(PENDING) // PENDING, APPLIED, EXPIRED
  appliedToJobId String?   // Job ID where credit was applied
  expiresAt   DateTime?    // Optional expiration date
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([customerId])
  @@index([status])
  @@index([referralLinkId])
}

model ReferralEvent {
  id                  String            @id @default(uuid())
  referrerId          String
  referrer            Customer          @relation("ReferrerEvents", fields: [referrerId], references: [id], onDelete: Cascade)
  referredCustomerId String
  referredCustomer    Customer          @relation("ReferredCustomerEvents", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  branchId            String
  branch              Branch             @relation("BranchReferralEvents", fields: [branchId], references: [id], onDelete: Cascade)
  referralLinkId      String?
  referralLink        ReferralLink?     @relation(fields: [referralLinkId], references: [id])
  jobId               String?            // Job ID that triggered the referral
  status              ReferralEventStatus @default(PENDING) // PENDING, COMPLETED, CANCELLED
  referrerCreditId    String?            // Credit given to referrer
  referredDiscountApplied Boolean       @default(false) // Whether $20 discount was applied
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @updatedAt

  @@index([referrerId])
  @@index([referredCustomerId])
  @@index([branchId])
  @@index([status])
  @@index([referralLinkId])
}

enum ReferralCreditStatus {
  PENDING
  APPLIED
  EXPIRED
  CANCELLED
}

enum ReferralEventStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  ACTIVE
  BOOKED
  CLOSED
  QUALIFIED
  REJECTED
}

// ============================================
// NURTURE SEQUENCE MODELS
// ============================================

model NurtureSequence {
  id              String   @id @default(uuid())
  customerId      String   @unique
  customer        Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)
  isActive        Boolean  @default(true)
  currentDay      Int      @default(0) // 0-7
  startedAt       DateTime @default(now())
  pausedAt        DateTime? // If customer replied
  completedAt     DateTime?
  referralCode    String?  // Referral code to attach
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  history         NurtureHistory[]

  @@index([customerId])
  @@index([branchId])
  @@index([isActive])
}

model NurtureHistory {
  id                String   @id @default(uuid())
  customerId        String
  customer          Customer  @relation(fields: [customerId], references: [id], onDelete: Cascade)
  nurtureSequenceId String?
  nurtureSequence   NurtureSequence? @relation(fields: [nurtureSequenceId], references: [id], onDelete: Cascade)
  day               Int      // 0-7
  message           String   @db.Text
  channel           NurtureChannel // WHATSAPP or SMS
  status            NurtureMessageStatus @default(PENDING) // PENDING, SENT, FAILED, STOPPED
  messageId         String?  // WhatsApp/SMS message ID
  sentAt            DateTime?
  errorMessage      String?  @db.Text
  createdAt         DateTime @default(now())

  @@index([customerId])
  @@index([nurtureSequenceId])
  @@index([day])
  @@index([status])
}

enum NurtureChannel {
  WHATSAPP
  SMS
}

enum NurtureMessageStatus {
  PENDING
  SENT
  FAILED
  STOPPED
}

// ============================================
// PROMO MODELS
// ============================================

model Promo {
  id           String   @id @default(cuid())
  branchId     String
  branch       Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  month        Int      // 1-12
  year         Int      // e.g., 2024, 2025
  title        String
  description  String   @db.Text
  discountType String   // "percent" | "fixed"
  discountValue Int     // e.g., 15 for 15% or 20 for $20
  active       Boolean  @default(true)
  startDate    DateTime
  endDate      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([branchId, month, year])
  @@index([branchId])
  @@index([active])
  @@index([startDate, endDate])
  @@index([month, year])
}

// ============================================
// LEAD QUALIFICATION MODELS
// ============================================

model Lead {
  id              String     @id @default(cuid())
  branchId        String
  branch          Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name            String
  phone           String
  email           String?
  zip             String?
  bedrooms        Int?
  bathrooms       Int?
  pets            Boolean    @default(false)
  homeType        String?    // "house" | "apartment" | "condo" | "townhouse"
  urgency         String?    // "asap" | "this_week" | "this_month" | "exploring"
  previousService Boolean    @default(false)
  referralSource  String?    // "google" | "referral" | "facebook" | "direct"
  leadScore       Int        @default(0)
  leadTier        String     @default("C") // "A" | "B" | "C"
  riskFlags       String[]   @default([])
  status          LeadStatus @default(NEW) // "new" | "active" | "qualified" | "rejected"
  depositPaid     Boolean    @default(false)
  depositUrl      String?
  customerId      String?    // If converted to customer
  waitForMorning  Boolean    @default(false) // After-hours queue flag
  afterHoursMessage String?  @db.Text // Last after-hours message sent
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  @@index([branchId])
  @@index([status])
  @@index([leadTier])
  @@index([leadScore])
  @@index([phone])
  @@index([email])
  @@index([zip])
  @@index([waitForMorning])
}

