generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Branch {
  id                                String                      @id
  name                              String
  slug                              String                      @unique
  country                           String                      @default("US")
  state                             String
  city                              String
  regionLabel                       String?
  timezone                          String
  primaryPhone                      String
  whatsappNumber                    String
  managerId                         String?
  pricingModelId                    String?
  status                            BranchStatus                @default(COMING_SOON)
  createdAt                         DateTime                    @default(now())
  updatedAt                         DateTime
  currency                          String                      @default("USD")
  AssignmentLog                     AssignmentLog[]
  User_Branch_managerIdToUser       User?                       @relation("Branch_managerIdToUser", fields: [managerId], references: [id])
  PricingModel                      PricingModel?               @relation(fields: [pricingModelId], references: [id])
  BranchAutomationConfig            BranchAutomationConfig?
  BranchConfig                      BranchConfig?
  BranchLandingContent              BranchLandingContent?
  BranchMetrics                     BranchMetrics?
  BranchOnboardingResources         BranchOnboardingResources[]
  BranchPayoutRules                 BranchPayoutRules?
  BranchServiceArea                 BranchServiceArea[]
  BranchServicePackage              BranchServicePackage[]
  BranchSops                        BranchSops[]
  CleanerApplication                CleanerApplication[]
  CleanerBalanceLedger              CleanerBalanceLedger[]
  CleanerPayout                     CleanerPayout[]
  Customer                          Customer[]
  JamaicaPayout                     JamaicaPayout[]
  Job                               Job[]
  JobPayout                         JobPayout[]
  Lead                              Lead[]
  NurtureSequence                   NurtureSequence[]
  PayoutTransfer                    PayoutTransfer[]
  Promo                             Promo[]
  ReferralEvent                     ReferralEvent[]
  ReferralLink                      ReferralLink[]
  TransactionLedger                 TransactionLedger[]
  User_User_primaryBranchIdToBranch User[]                      @relation("User_primaryBranchIdToBranch")
  UserBranch                        UserBranch[]
  WorkerRunLog                      WorkerRunLog[]

  @@index([managerId])
  @@index([pricingModelId])
  @@index([slug])
  @@index([status])
}

model BranchAutomationConfig {
  id                       String   @id
  branchId                 String   @unique
  bookingWebhookUrl        String?
  reminderWebhookUrl       String?
  reviewWebhookUrl         String?
  whatsappTemplateBooking  String?
  whatsappTemplateReminder String?
  whatsappTemplateReview   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime
  Branch                   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchConfig {
  id                     String   @id
  branchId               String   @unique
  bookingEmail           String?
  supportEmail           String?
  maxDailyJobs           Int?
  whatsappTemplateConfig Json?
  zapierHooks            Json?
  operationsFlags        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime
  Branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchLandingContent {
  id             String   @id
  branchId       String   @unique
  headline       String?
  subheadline    String?
  heroImageUrl   String?
  localCtaLabel  String?
  seoTitle       String?
  seoDescription String?
  testimonials   Json?
  faqEntries     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  cityContent    Json?
  Branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchOnboardingResources {
  id          String   @id
  branchId    String
  name        String
  description String?
  resourceUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  Branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model BranchPayoutRules {
  id                     String       @id
  branchId               String       @unique
  baseRateType           BaseRateType
  baseRateValue          Decimal      @db.Decimal(10, 2)
  overtimeRules          Json?
  tipHandling            TipHandling
  franchiseFeePercentage Decimal?     @db.Decimal(5, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime
  Branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchServiceArea {
  id        String   @id
  branchId  String
  zipCode   String
  priority  Int      @default(1)
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime
  Branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, zipCode])
  @@index([branchId])
  @@index([zipCode])
  @@index([zipCode, priority])
}

model BranchServicePackage {
  id                   String   @id
  branchId             String
  code                 String
  name                 String
  description          String?
  defaultDurationHours Int
  basePrice            Decimal  @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime
  currency             String?  @default("USD")
  pricingData          Json?
  Branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, isActive])
}

model BranchSops {
  id        String      @id
  branchId  String
  category  SopCategory
  title     String
  docUrl    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime
  Branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId, category])
  @@index([branchId])
}

model CleanerApplication {
  id                  String                   @id
  name                String
  email               String
  phone               String
  branchId            String
  experienceLevel     String?
  daysAvailable       Json?
  notes               String?
  status              CleanerApplicationStatus @default(NEW)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime
  applicantFitScore   Int?
  areaOfResidence     String?
  canTravelToVillas   Boolean                  @default(false)
  idUploadUrl         String?
  referencesUploadUrl String?
  weekendAbility      Boolean                  @default(false)
  whatsappNumber      String?
  preferredName       String?
  applicationData     Json?
  Branch              Branch                   @relation(fields: [branchId], references: [id])

  @@index([applicantFitScore])
  @@index([branchId])
  @@index([email])
  @@index([status])
}

model CleanerAvailability {
  id            String   @id
  cleanerId     String   @unique
  workingDays   Json
  timeRanges    Json
  maxDailyJobs  Int      @default(3)
  blackoutDates Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  User          User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([isActive])
}

model Contract {
  id        String    @id
  name      String
  type      String
  branch    String    @default("port-antonio")
  url       String
  status    String    @default("PENDING")
  signedAt  DateTime?
  signedBy  String?
  phone     String?
  email     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime

  @@index([branch])
  @@index([createdAt])
  @@index([status])
  @@index([type])
}

model Customer {
  id                                                       String                     @id
  firstName                                                String
  lastName                                                 String
  email                                                    String                     @unique
  phone                                                    String?                    @db.VarChar(50)
  defaultAddress                                           String?
  homeZipCode                                              String?
  branchId                                                 String?
  stripeCustomerId                                         String?                    @unique
  loyaltyPoints                                            Int                        @default(0)
  createdAt                                                DateTime                   @default(now())
  updatedAt                                                DateTime
  preferSameCleaner                                        Boolean                    @default(false)
  leadStatus                                               LeadStatus                 @default(NEW)
  whatsappOptIn                                            Boolean                    @default(false)
  isBlocked                                                Boolean                    @default(false)
  riskFlags                                                String[]                   @default([])
  riskScore                                                Int                        @default(0)
  loginCode                                                String?
  loginCodeExpiresAt                                       DateTime?
  invitedAt                                                DateTime?
  addressLine1                                             String?                    @db.VarChar(255)
  addressLine2                                             String?                    @db.VarChar(255)
  city                                                     String?                    @db.VarChar(100)
  notifyEmail                                              Boolean                    @default(true)
  notifySMS                                                Boolean                    @default(false)
  postalCode                                               String?                    @db.VarChar(20)
  state                                                    String?                    @db.VarChar(100)
  CleanerRating                                            CleanerRating[]
  Branch                                                   Branch?                    @relation(fields: [branchId], references: [id])
  CustomerJobChangeRequest                                 CustomerJobChangeRequest[]
  CustomerLoginToken                                       CustomerLoginToken[]
  Job                                                      Job[]
  NurtureHistory                                           NurtureHistory[]
  NurtureSequence                                          NurtureSequence?
  ReferralCredit                                           ReferralCredit[]
  ReferralEvent_ReferralEvent_referredCustomerIdToCustomer ReferralEvent[]            @relation("ReferralEvent_referredCustomerIdToCustomer")
  ReferralEvent_ReferralEvent_referrerIdToCustomer         ReferralEvent[]            @relation("ReferralEvent_referrerIdToCustomer")
  ReferralLink                                             ReferralLink[]
  Invoice                                                  Invoice[]
  Receipt                                                  Receipt[]

  @@index([branchId])
  @@index([email])
  @@index([homeZipCode])
  @@index([leadStatus])
  @@index([isBlocked])
  @@index([riskScore])
}

model FranchiseApplication {
  id                      String                     @id
  name                    String
  email                   String
  phone                   String
  city                    String
  state                   String
  country                 String
  desiredBranchSlug       String?
  background              String?
  investmentCapacityRange String?
  notes                   String?
  status                  FranchiseApplicationStatus @default(PENDING)
  internalNotes           String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime

  @@index([city, state])
  @@index([email])
  @@index([status])
}

model JamaicaPaymentMethod {
  id             String   @id
  cleanerId      String   @unique
  bankName       String?
  accountNumber  String?
  accountType    String?
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime
  User           User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
}

model JamaicaPayout {
  id            String   @id
  cleanerId     String
  branchId      String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  currency      String   @default("JMD")
  status        String   @default("PENDING")
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User          User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([cleanerId])
  @@index([periodStart, periodEnd])
  @@index([status])
}

model Job {
  id                       String                     @id
  sessionId                String?                    @unique
  branchId                 String
  customerId               String?
  assignedCleanerId        String?
  customerName             String?
  preferredDate            DateTime?
  preferredTime            String?
  serviceType              String?
  serviceLocation          String?
  address                  String?
  totalPrice               Decimal?                   @db.Decimal(10, 2)
  quotedTotal              Decimal?                   @db.Decimal(10, 2)
  depositAmount            Decimal?                   @db.Decimal(10, 2)
  amountPaid               Decimal?                   @db.Decimal(10, 2)
  balanceDue               Decimal?                   @db.Decimal(10, 2)
  paymentStatus            PaymentStatus              @default(PENDING)
  reviewStatus             JobReviewStatus            @default(PENDING)
  depositPaymentIntentId   String?
  balanceSessionId         String?                    @unique
  balancePaymentIntentId   String?
  depositPaidAt            DateTime?
  balancePaidAt            DateTime?
  paidAt                   DateTime?
  paymentReference         String?
  approvedAt               DateTime?
  approvedById             String?
  createdAt                DateTime                   @default(now())
  assignedAt               DateTime?
  onTheWayAt               DateTime?
  completedAt              DateTime?
  currency                 String?                    @default("USD")
  paymentMethod            String?
  jobQualityScore          Int?
  appliedReferralCode      String?
  promoApplied             String?
  promoDiscount            Decimal?                   @db.Decimal(10, 2)
  cancellationReason       String?
  cancelledAt              DateTime?
  status                   JobStatus                  @default(RECEIVED)
  completedBy              String?
  cleanDurationMins        Int?
  notifiedAt               DateTime?
  internalNotes            String?
  marketLabel              String?
  archivedAt               DateTime?
  AssignmentLog            AssignmentLog[]
  photos                   CleanPhoto[]
  CleanerBalanceLedger     CleanerBalanceLedger[]
  CleanerRating            CleanerRating?
  ComplianceIssue          ComplianceIssue[]
  CustomerJobChangeRequest CustomerJobChangeRequest[]
  JobChecklistItem         JobChecklistItem[]
  JobTeamMember            JobTeamMember[]
  CompletionReport         CompletionReport?
  Invoice                  Invoice?
  Receipts                 Receipt[]
  User                     User?                      @relation(fields: [assignedCleanerId], references: [id])
  ApprovedBy               User?                      @relation("JobApprovedBy", fields: [approvedById], references: [id])
  Branch                   Branch                     @relation(fields: [branchId], references: [id])
  Customer                 Customer?                  @relation(fields: [customerId], references: [id])
  JobPayout                JobPayout?

  @@index([appliedReferralCode])
  @@index([assignedCleanerId])
  @@index([branchId])
  @@index([customerId])
  @@index([jobQualityScore])
  @@index([preferredDate])
  @@index([status])
  @@index([paymentStatus])
  @@index([reviewStatus])
  @@index([archivedAt])
}

model CleanPhoto {
  id         String   @id @default(cuid())
  jobId      String
  url        String
  caption    String?
  uploadedBy String?
  uploadedAt DateTime @default(now())
  Job        Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@map("clean_photos")
}

model CleanerProfile {
  id                  String   @id @default(cuid())
  userId              String   @unique
  firstName           String?
  lastName            String?
  publicDisplayName   String?
  jobTitle            String?
  serviceAreas        Json?
  memberStatus        String   @default("ACTIVE")
  certificationLabel  String   @default("PENDING")
  internalNotes       String?
  isInternalTeam      Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  User                User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([memberStatus])
  @@index([isInternalTeam])
}

model JobTeamMember {
  id        String @id @default(cuid())
  jobId     String
  cleanerId String
  sortOrder Int    @default(0)
  Job       Job    @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User      User   @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([jobId, cleanerId])
  @@index([jobId])
  @@index([cleanerId])
}

model ReviewRequest {
  id           String    @id @default(cuid())
  jobId        String
  clientEmail  String
  scheduledFor DateTime
  sentAt       DateTime?
  createdAt    DateTime  @default(now())

  @@index([jobId])
  @@index([scheduledFor])
  @@index([sentAt])
  @@map("review_requests")
}

model JobPayout {
  id                    String    @id
  jobId                 String    @unique
  cleanerId             String
  branchId              String
  grossAmount           Decimal   @db.Decimal(10, 2)
  cleanerAmount         Decimal   @db.Decimal(10, 2)
  platformFee           Decimal   @db.Decimal(10, 2)
  currency              String    @default("USD")
  status                String    @default("READY")
  rulesVersion          String?
  policyVersionId       String?
  policyEvalDetails     Json?
  paymentMethodSnapshot Json?
  executionMethod       String?
  externalReferenceId   String?
  createdAt             DateTime  @default(now())
  paidAt                DateTime?
  executedAt            DateTime?
  Job                   Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  User                  User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  Branch                Branch    @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([branchId])
  @@index([status])
  @@index([createdAt])
}

model AssignmentLog {
  id        String   @id @default(cuid())
  jobId     String
  cleanerId String?
  branchId  String
  outcome   String
  reason    String?
  details   Json?
  createdAt DateTime @default(now())
  Branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([jobId])
  @@index([branchId])
  @@index([createdAt])
}

model JobChecklistItem {
  id              String    @id @default(cuid())
  jobId           String
  checklistItemId String
  completed       Boolean   @default(false)
  completedAt     DateTime?
  completedById   String?
  notes           String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  job             Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)
  completedBy     User?     @relation("JobChecklistItem_completedBy", fields: [completedById], references: [id], onDelete: SetNull)

  @@unique([jobId, checklistItemId])
  @@index([jobId])
  @@index([completedById])
}

model CleanerRating {
  id         String    @id @default(cuid())
  jobId      String    @unique
  cleanerId  String
  customerId String?
  rating     Int
  comment    String?
  createdAt  DateTime  @default(now())
  Cleaner    User      @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  Customer   Customer? @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Job        Job       @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([customerId])
  @@index([rating])
  @@index([createdAt])
}

model Lead {
  id                String     @id
  branchId          String
  name              String
  phone             String
  email             String?
  zip               String?
  bedrooms          Int?
  bathrooms         Int?
  pets              Boolean    @default(false)
  homeType          String?
  urgency           String?
  previousService   Boolean    @default(false)
  referralSource    String?
  leadScore         Int        @default(0)
  leadTier          String     @default("C")
  riskFlags         String[]   @default([])
  status            LeadStatus @default(NEW)
  depositPaid       Boolean    @default(false)
  depositUrl        String?
  customerId        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime
  afterHoursMessage String?
  waitForMorning    Boolean    @default(false)
  Branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([email])
  @@index([leadScore])
  @@index([leadTier])
  @@index([phone])
  @@index([status])
  @@index([waitForMorning])
  @@index([zip])
}

model LessonProgress {
  id             String         @id
  cleanerId      String
  lessonId       String
  status         String         @default("NOT_STARTED")
  score          Int?
  completedAt    DateTime?
  User           User           @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  TrainingLesson TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, lessonId])
  @@index([cleanerId])
  @@index([lessonId])
  @@index([status])
}

model NurtureHistory {
  id                String               @id
  customerId        String
  nurtureSequenceId String?
  day               Int
  message           String
  channel           NurtureChannel
  status            NurtureMessageStatus @default(PENDING)
  messageId         String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  Customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  NurtureSequence   NurtureSequence?     @relation(fields: [nurtureSequenceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([day])
  @@index([nurtureSequenceId])
  @@index([status])
}

model NurtureSequence {
  id             String           @id
  customerId     String           @unique
  branchId       String
  isActive       Boolean          @default(true)
  currentDay     Int              @default(0)
  startedAt      DateTime         @default(now())
  pausedAt       DateTime?
  completedAt    DateTime?
  referralCode   String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  NurtureHistory NurtureHistory[]
  Branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([customerId])
  @@index([isActive])
}

model PricingModel {
  id            String      @id
  name          String
  billingType   BillingType
  currency      String      @default("USD")
  baseRate      Decimal     @db.Decimal(10, 2)
  extraHourRate Decimal?    @db.Decimal(10, 2)
  minHours      Int?
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime
  Branch        Branch[]

  @@index([name])
}

model Promo {
  id            String   @id
  branchId      String
  month         Int
  year          Int
  title         String
  description   String
  discountType  String
  discountValue Int
  active        Boolean  @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime
  Branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month, year])
  @@index([active])
  @@index([branchId])
  @@index([month, year])
  @@index([startDate, endDate])
}

model ReferralCredit {
  id             String               @id
  customerId     String
  referralLinkId String?
  amount         Decimal              @db.Decimal(10, 2)
  status         ReferralCreditStatus @default(PENDING)
  appliedToJobId String?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime
  Customer       Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ReferralLink   ReferralLink?        @relation(fields: [referralLinkId], references: [id])

  @@index([customerId])
  @@index([referralLinkId])
  @@index([status])
}

model ReferralEvent {
  id                                                  String              @id
  referrerId                                          String
  referredCustomerId                                  String
  branchId                                            String
  referralLinkId                                      String?
  jobId                                               String?
  status                                              ReferralEventStatus @default(PENDING)
  referrerCreditId                                    String?
  referredDiscountApplied                             Boolean             @default(false)
  createdAt                                           DateTime            @default(now())
  updatedAt                                           DateTime
  Branch                                              Branch              @relation(fields: [branchId], references: [id], onDelete: Cascade)
  ReferralLink                                        ReferralLink?       @relation(fields: [referralLinkId], references: [id])
  Customer_ReferralEvent_referredCustomerIdToCustomer Customer            @relation("ReferralEvent_referredCustomerIdToCustomer", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  Customer_ReferralEvent_referrerIdToCustomer         Customer            @relation("ReferralEvent_referrerIdToCustomer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([referralLinkId])
  @@index([referredCustomerId])
  @@index([referrerId])
  @@index([status])
}

model ReferralLink {
  id             String           @id
  customerId     String
  branchId       String
  code           String           @unique
  isActive       Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  ReferralCredit ReferralCredit[]
  ReferralEvent  ReferralEvent[]
  Branch         Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  Customer       Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([code])
  @@index([customerId])
}

model TrainingCertificate {
  id               String         @id
  certificateId    String         @unique
  cleanerId        String         @unique
  status           String         @default("ACTIVE")
  issuedAt         DateTime       @default(now())
  revokedAt        DateTime?
  trainingStatusId String         @unique
  cleaner          User           @relation("TrainingCertificate_cleaner", fields: [cleanerId], references: [id], onDelete: Cascade, map: "TrainingCertificate_cleaner_fkey")
  TrainingStatus   TrainingStatus @relation(fields: [trainingStatusId], references: [id], onDelete: Cascade, map: "TrainingCertificate_trainingstatus_fkey")

  @@index([certificateId])
  @@index([cleanerId])
  @@index([status])
  @@index([trainingStatusId])
}

model TrainingLesson {
  id             String           @id
  moduleId       String
  title          String
  content        String
  order          Int
  quizJson       Json?
  LessonProgress LessonProgress[]
  TrainingModule TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  TrainingQuiz   TrainingQuiz?

  @@index([moduleId])
  @@index([moduleId, order])
}

model TrainingModule {
  id             String           @id
  slug           String           @unique
  title          String
  description    String
  order          Int
  isActive       Boolean          @default(true)
  TrainingLesson TrainingLesson[]

  @@index([isActive])
  @@index([order])
  @@index([slug])
}

model TrainingQuestion {
  id            String       @id
  quizId        String
  question      String
  order         Int
  questionType  String       @default("MULTIPLE_CHOICE")
  options       Json
  correctAnswer Int
  explanation   String?
  TrainingQuiz  TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, order])
}

model TrainingQuiz {
  id                  String                @id
  lessonId            String                @unique
  title               String
  passingScore        Int                   @default(70)
  timeLimit           Int?
  isActive            Boolean               @default(true)
  TrainingQuestion    TrainingQuestion[]
  TrainingLesson      TrainingLesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  TrainingQuizAttempt TrainingQuizAttempt[]

  @@index([isActive])
  @@index([lessonId])
}

model TrainingQuizAttempt {
  id           String       @id
  cleanerId    String
  quizId       String
  lessonId     String
  score        Int
  passed       Boolean
  answers      Json
  startedAt    DateTime     @default(now())
  completedAt  DateTime?
  User         User         @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  TrainingQuiz TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([lessonId])
  @@index([passed])
  @@index([quizId])
  @@index([startedAt])
}

model TrainingStatus {
  id                  String               @id
  cleanerId           String               @unique
  overallStatus       String               @default("NOT_STARTED")
  lastModuleSlug      String?
  updatedAt           DateTime
  TrainingCertificate TrainingCertificate?
  User                User                 @relation("TrainingStatus_cleaner", fields: [cleanerId], references: [id], onDelete: Cascade, map: "TrainingStatus_cleanerId_User_fkey")

  @@index([cleanerId])
  @@index([overallStatus])
}

model TransactionLedger {
  id              String   @id
  branchId        String?
  transactionType String
  amount          Float
  currency        String   @default("JMD")
  description     String?
  referenceId     String?
  referenceType   String?
  cleanerId       String?
  customerId      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  Branch          Branch?  @relation(fields: [branchId], references: [id])
  User            User?    @relation(fields: [cleanerId], references: [id])

  @@index([branchId])
  @@index([cleanerId])
  @@index([createdAt])
  @@index([customerId])
  @@index([referenceId, referenceType])
  @@index([transactionType])
}

model User {
  id                                  String                 @id
  email                               String                 @unique
  name                                String?
  phone                               String?
  role                                UserRole               @default(CLEANER)
  primaryBranchId                     String?
  createdAt                           DateTime               @default(now())
  updatedAt                           DateTime
  stripeAccountId                     String?
  stripeChargesEnabled                Boolean                @default(false)
  stripePayoutsEnabled                Boolean                @default(false)
  stripeOnboardingStatus              String?
  stripeRequirementsDueCount          Int                    @default(0)
  stripeLastAccountUpdateAt           DateTime?
  isActive                            Boolean                @default(false)
  homeZip                             String?
  preferredCities                     String[]               @default([])
  isSuspended                         Boolean                @default(false)
  warningCount                        Int                    @default(0)
  AuditLog                            AuditLog[]
  Branch_Branch_managerIdToUser       Branch[]               @relation("Branch_managerIdToUser")
  CleanerAvailability                 CleanerAvailability?
  CleanerBalanceLedger                CleanerBalanceLedger[]
  CleanerPaymentMethod                CleanerPaymentMethod[]
  CleanerPayout                       CleanerPayout[]
  CleanerRating                       CleanerRating[]
  CleanerTrainingProgress             CleanerTrainingProgress[]
  ComplianceIssue                     ComplianceIssue[]
  JamaicaPaymentMethod                JamaicaPaymentMethod?
  JamaicaPayout                       JamaicaPayout[]
  Job                                 Job[]
  JobPayout                           JobPayout[]
  JobsApproved                        Job[]                  @relation("JobApprovedBy")
  JobChecklistItemCompleted           JobChecklistItem[]     @relation("JobChecklistItem_completedBy")
  LessonProgress                      LessonProgress[]
  PayoutTransfer                      PayoutTransfer[]
  TrainingCertificate                 TrainingCertificate?   @relation("TrainingCertificate_cleaner")
  TrainingQuizAttempt                 TrainingQuizAttempt[]
  TrainingStatus                      TrainingStatus?        @relation("TrainingStatus_cleaner")
  CleanerProfile                      CleanerProfile?
  JobTeamMember                       JobTeamMember[]
  TransactionLedger                   TransactionLedger[]
  Branch_User_primaryBranchIdToBranch Branch?                @relation("User_primaryBranchIdToBranch", fields: [primaryBranchId], references: [id])
  UserBranch                          UserBranch[]

  @@index([isActive])
  @@index([preferredCities])
  @@index([primaryBranchId])
  @@index([role])
  @@index([isSuspended])
  @@index([warningCount])
}

model UserBranch {
  id        String   @id
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  Branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([branchId])
  @@index([userId])
}

model VillaPartnerApplication {
  id                String   @id
  propertyName      String
  managerName       String
  whatsapp          String
  bedrooms          Int
  bathrooms         Int
  turnoverFrequency String
  needsInventory    Boolean  @default(false)
  needsLinenService Boolean  @default(false)
  notes             String?
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime

  @@index([createdAt])
  @@index([status])
}

model CleanerBalanceLedger {
  id               String            @id @default(cuid())
  cleanerId        String
  branchId         String?
  jobId            String?
  payoutTransferId String?
  type             LedgerEntryType
  status           LedgerEntryStatus @default(POSTED)
  amountCents      Int
  currency         String            @default("USD")
  description      String?
  createdAt        DateTime          @default(now())
  branch           Branch?           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cleaner          User              @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  job              Job?              @relation(fields: [jobId], references: [id], onDelete: Cascade)
  payoutTransfer   PayoutTransfer?   @relation(fields: [payoutTransferId], references: [id])

  @@unique([jobId, type], map: "unique_credit_per_job")
  @@index([cleanerId, createdAt])
}

model PayoutBatch {
  id               String            @id @default(cuid())
  periodStart      DateTime
  periodEnd        DateTime
  status           PayoutBatchStatus @default(DRAFT)
  createdByAdminId String?
  createdAt        DateTime          @default(now())
  totalAmountCents Int?
  transfers        PayoutTransfer[]

  @@index([periodStart, periodEnd])
}

model PayoutTransfer {
  id             String                 @id @default(cuid())
  batchId        String
  cleanerId      String
  branchId       String?
  amountCents    Int
  currency       String                 @default("USD")
  stripePayoutId String?
  status         PayoutTransferStatus   @default(PENDING)
  failureReason  String?
  createdAt      DateTime               @default(now())
  ledgerEntries  CleanerBalanceLedger[]
  batch          PayoutBatch            @relation(fields: [batchId], references: [id], onDelete: Cascade)
  branch         Branch?                @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cleaner        User                   @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId, status])
}

model TaxYearArchive {
  year           Int      @id
  archivedAt     DateTime @default(now())
  archivedBy     String?
  readinessScore Float
  status         String
  summaryJson    Json

  @@index([year])
}

model CleanerTrainingProgress {
  id          String   @id @default(cuid())
  cleanerId   String
  moduleSlug  String
  completedAt DateTime @default(now())
  quizScore   Int?
  User        User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, moduleSlug])
  @@index([cleanerId])
  @@index([moduleSlug])
}

model ComplianceIssue {
  id           String                @id @default(cuid())
  cleanerId    String
  jobId        String?
  type         ComplianceIssueType
  status       ComplianceIssueStatus
  severity     ComplianceSeverity
  reason       String
  notes        String?
  createdById  String?
  resolvedById String?
  createdAt    DateTime              @default(now())
  resolvedAt   DateTime?
  cleaner      User                  @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  job          Job?                  @relation(fields: [jobId], references: [id])

  @@index([cleanerId, status])
  @@index([jobId])
}

model InvestorAccessRequest {
  id           String               @id @default(cuid())
  name         String
  email        String
  organization String?
  interest     String?
  createdAt    DateTime             @default(now())
  status       InvestorAccessStatus @default(PENDING)
  approvedAt   DateTime?
  approvedBy   String?
}

model ContactMessage {
  id            String                @id @default(cuid())
  role          String
  name          String
  email         String
  organization  String?
  message       String?
  createdAt     DateTime              @default(now())
  status        ContactMessageStatus  @default(NEW)
  updatedAt     DateTime              @default(now()) @updatedAt
  reviewedAt    DateTime?
  repliedAt     DateTime?
  archivedAt    DateTime?
  internalNotes ContactInternalNote[]
  replies       ContactReply[]
}

model ContactReply {
  id               String         @id @default(cuid())
  contactMessageId String
  body             String
  repliedByAdminId String?
  createdAt        DateTime       @default(now())
  sentViaEmail     Boolean        @default(true)
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
}

model ContactReplyTemplate {
  id        String   @id @default(cuid())
  title     String
  role      String
  body      String
  createdAt DateTime @default(now())
}

model ContactInternalNote {
  id               String         @id @default(cuid())
  contactMessageId String
  body             String
  createdAt        DateTime       @default(now())
  contactMessage   ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id          String   @id
  actorId     String?
  actorRole   String?
  action      String
  entityType  String
  entityId    String
  description String?
  changes     Json?
  createdAt   DateTime @default(now())
  User        User?    @relation(fields: [actorId], references: [id])

  @@index([actorId])
  @@index([createdAt])
  @@index([entityType, entityId])
}

model BranchMetrics {
  id              String   @id
  branchId        String   @unique
  jobsToday       Int      @default(0)
  jobsThisWeek    Int      @default(0)
  revenueThisWeek Float    @default(0)
  unassignedJobs  Int      @default(0)
  updatedAt       DateTime
  Branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model CleanerPaymentMethod {
  id         String   @id
  cleanerId  String
  methodType String
  label      String?
  details    Json
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime
  User       User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([cleanerId, isActive])
}

model CleanerPayout {
  id              String   @id
  cleanerId       String
  branchId        String
  fromDate        DateTime
  toDate          DateTime
  totalJobs       Int
  grossRevenue    Float
  cleanerEarnings Float
  bonuses         Float
  penalties       Float
  branchProfit    Float
  status          String   @default("DRAFT")
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  Branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  User            User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([cleanerId])
  @@index([createdAt])
  @@index([fromDate, toDate])
  @@index([status])
}

model CustomerJobChangeRequest {
  id          String   @id
  jobId       String
  customerId  String
  requestedAt DateTime @default(now())
  payload     Json
  status      String   @default("PENDING")
  Customer    Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  Job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([jobId])
  @@index([requestedAt])
  @@index([status])
}

model CustomerLoginToken {
  id         String   @id
  customerId String
  code       String
  expiresAt  DateTime
  used       Boolean  @default(false)
  createdAt  DateTime @default(now())
  Customer   Customer @relation(fields: [customerId], references: [id])

  @@index([code, customerId])
  @@index([customerId])
}

model WorkerRunLog {
  id         String   @id
  branchId   String
  jobType    String
  startedAt  DateTime
  finishedAt DateTime
  durationMs Int
  status     String
  error      String?
  Branch     Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([jobType])
  @@index([startedAt])
  @@index([status])
}

