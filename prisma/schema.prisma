model Tip {
  id                    String   @id @default(cuid())
  amount                Int
  currency              String   @default("usd")
  guestName             String?
  guestMessage          String?
  cleanerName           String?
  propertyAddress       String?
  stripePaymentIntentId String?  @unique
  status                String   @default("pending")
  market                String?
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  @@map("tips")
}

model Invoice {
  id              String         @id @default(cuid())
  invoiceNumber   String         @unique
  publicToken     String         @unique @default(cuid())
  jobId           String?        @unique
  customerId      String?
  clientName      String
  clientEmail     String?
  clientPhone     String?
  propertyAddress String
  serviceType     String
  jobDate         DateTime?
  dueDate         DateTime?
  subtotal        Decimal        @db.Decimal(10, 2)
  tax             Decimal        @default(0) @db.Decimal(10, 2)
  discount        Decimal        @default(0) @db.Decimal(10, 2)
  total           Decimal        @db.Decimal(10, 2)
  amountPaid      Decimal        @default(0) @db.Decimal(10, 2)
  balanceDue      Decimal        @db.Decimal(10, 2)
  status          InvoiceStatus  @default(DRAFT)
  notes           String?
  sentAt          DateTime?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  items           InvoiceItem[]
  payments        InvoicePayment[]
  Job             Job?           @relation(fields: [jobId], references: [id])
  Customer        Customer?      @relation(fields: [customerId], references: [id])
  Receipts        Receipt[]

  @@index([status])
  @@index([clientName])
  @@index([clientEmail])
  @@index([invoiceNumber])
  @@index([dueDate])
  @@index([publicToken])
  @@index([jobId])
  @@index([customerId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  description String
  quantity    Decimal @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal @db.Decimal(10, 2)
  lineTotal   Decimal @db.Decimal(10, 2)
  sortOrder   Int     @default(0)
  Invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@index([invoiceId])
}

model InvoicePayment {
  id                   String               @id @default(cuid())
  invoiceId            String
  amount               Decimal              @db.Decimal(10, 2)
  paymentMethod        InvoicePaymentMethod
  paymentDate          DateTime             @default(now())
  transactionReference String?
  notes                String?
  stripeSessionId      String?
  createdAt            DateTime             @default(now())
  Invoice              Invoice              @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  Receipt              Receipt?

  @@index([invoiceId])
}

enum CompletionReportStatus {
  DRAFT
  GENERATED
  SENT
}

enum ReceiptStatus {
  GENERATED
  SENT
}

model CompletionReport {
  id              String                 @id @default(cuid())
  jobId           String                 @unique
  reportNumber    String                 @unique
  publicToken     String                 @unique @default(cuid())
  propertyAddress String
  serviceDate     DateTime
  serviceType     String?
  teamSummary     String?
  notes           String?
  issuesFound     String?
  supplyRequests  String?
  beforePhotos    Json?
  afterPhotos     Json?
  status          CompletionReportStatus @default(GENERATED)
  sentAt          DateTime?
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt
  Job             Job                    @relation(fields: [jobId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([publicToken])
  @@map("completion_reports")
}

model Receipt {
  id               String               @id @default(cuid())
  receiptNumber    String               @unique
  publicToken      String               @unique @default(cuid())
  invoiceId        String?
  jobId            String?
  invoicePaymentId String?              @unique
  customerId       String?
  clientName       String
  clientEmail      String?
  amount           Decimal              @db.Decimal(10, 2)
  paymentMethod    InvoicePaymentMethod
  paymentDate      DateTime
  propertyAddress  String?
  serviceType      String?
  invoiceNumber    String?
  status           ReceiptStatus        @default(GENERATED)
  sentAt           DateTime?
  createdAt        DateTime             @default(now())
  Invoice          Invoice?             @relation(fields: [invoiceId], references: [id])
  Job              Job?                 @relation(fields: [jobId], references: [id])
  InvoicePayment   InvoicePayment?      @relation(fields: [invoicePaymentId], references: [id])
  Customer         Customer?            @relation(fields: [customerId], references: [id])

  @@index([jobId])
  @@index([invoiceId])
  @@index([customerId])
  @@index([publicToken])
  @@map("receipts")
}
