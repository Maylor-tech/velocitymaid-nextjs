generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  email                String                @unique
  name                 String?
  role                 UserRole              @default(CLEANER)
  primaryBranchId      String?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  isActive             Boolean               @default(false)
  homeZip              String?
  preferredCities      String[]              @default([])
  managedBranches      Branch[]              @relation("BranchManager")
  availability         CleanerAvailability?
  jamaicaPaymentMethod JamaicaPaymentMethod?
  jamaicaPayouts       JamaicaPayout[]       @relation("CleanerPayouts")
  assignedJobs         Job[]                 @relation("AssignedJobs")
  lessonProgresses     LessonProgress[]
  certificate          TrainingCertificate?  @relation("CleanerCertificate")
  quizAttempts         TrainingQuizAttempt[]
  trainingStatus       TrainingStatus?
  transactions         TransactionLedger[]
  primaryBranch        Branch?               @relation("UserPrimaryBranch", fields: [primaryBranchId], references: [id])
  userBranches         UserBranch[]

  @@index([primaryBranchId])
  @@index([role])
  @@index([isActive])
  @@index([preferredCities])
}

model UserBranch {
  id        String   @id @default(uuid())
  userId    String
  branchId  String
  createdAt DateTime @default(now())
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
  @@index([userId])
  @@index([branchId])
}

model Customer {
  id                String           @id @default(uuid())
  firstName         String
  lastName          String
  email             String           @unique
  phone             String?
  defaultAddress    String?
  homeZipCode       String?
  branchId          String?
  stripeCustomerId  String?          @unique
  loyaltyPoints     Int              @default(0)
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
  preferSameCleaner Boolean          @default(false)
  leadStatus        LeadStatus       @default(NEW)
  whatsappOptIn     Boolean          @default(false)
  branch            Branch?          @relation(fields: [branchId], references: [id])
  jobs              Job[]
  nurtureHistory    NurtureHistory[]
  nurtureSequence   NurtureSequence?
  referralCredits   ReferralCredit[] @relation("CustomerReferralCredits")
  referredEvents    ReferralEvent[]  @relation("ReferredCustomerEvents")
  referrerEvents    ReferralEvent[]  @relation("ReferrerEvents")
  referralLinks     ReferralLink[]   @relation("CustomerReferralLinks")

  @@index([email])
  @@index([branchId])
  @@index([homeZipCode])
  @@index([leadStatus])
}

model Branch {
  id                  String                      @id @default(uuid())
  name                String
  slug                String                      @unique
  country             String                      @default("US")
  state               String
  city                String
  regionLabel         String?
  timezone            String
  primaryPhone        String
  whatsappNumber      String
  managerId           String?
  pricingModelId      String?
  status              BranchStatus                @default(COMING_SOON)
  createdAt           DateTime                    @default(now())
  updatedAt           DateTime                    @updatedAt
  currency            String                      @default("USD")
  manager             User?                       @relation("BranchManager", fields: [managerId], references: [id])
  pricingModel        PricingModel?               @relation(fields: [pricingModelId], references: [id])
  automationConfig    BranchAutomationConfig?
  config              BranchConfig?
  landingContent      BranchLandingContent?
  onboardingResources BranchOnboardingResources[]
  payoutRules         BranchPayoutRules?
  serviceAreas        BranchServiceArea[]
  servicePackages     BranchServicePackage[]
  sops                BranchSops[]
  cleanerApplications CleanerApplication[]
  customers           Customer[]
  jamaicaPayouts      JamaicaPayout[]
  jobs                Job[]
  leads               Lead[]
  nurtureSequences    NurtureSequence[]
  promos              Promo[]
  referralEvents      ReferralEvent[]             @relation("BranchReferralEvents")
  referralLinks       ReferralLink[]              @relation("BranchReferralLinks")
  transactions        TransactionLedger[]
  primaryUsers        User[]                      @relation("UserPrimaryBranch")
  userBranches        UserBranch[]

  @@index([slug])
  @@index([status])
  @@index([managerId])
  @@index([pricingModelId])
}

model BranchServiceArea {
  id        String   @id @default(uuid())
  branchId  String
  zipCode   String
  priority  Int      @default(1)
  city      String?
  state     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, zipCode])
  @@index([branchId])
  @@index([zipCode])
  @@index([zipCode, priority])
}

model PricingModel {
  id            String      @id @default(uuid())
  name          String
  billingType   BillingType
  currency      String      @default("USD")
  baseRate      Decimal     @db.Decimal(10, 2)
  extraHourRate Decimal?    @db.Decimal(10, 2)
  minHours      Int?
  internalNotes String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  branches      Branch[]

  @@index([name])
}

model BranchServicePackage {
  id                   String   @id @default(uuid())
  branchId             String
  code                 String
  name                 String
  description          String?
  defaultDurationHours Int
  basePrice            Decimal  @db.Decimal(10, 2)
  isActive             Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  currency             String?  @default("USD")
  pricingData          Json?
  branch               Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, code])
  @@index([branchId])
  @@index([branchId, isActive])
}

model BranchConfig {
  id                     String   @id @default(uuid())
  branchId               String   @unique
  bookingEmail           String?
  supportEmail           String?
  maxDailyJobs           Int?
  whatsappTemplateConfig Json?
  zapierHooks            Json?
  operationsFlags        Json?
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt
  branch                 Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchAutomationConfig {
  id                       String   @id @default(uuid())
  branchId                 String   @unique
  bookingWebhookUrl        String?
  reminderWebhookUrl       String?
  reviewWebhookUrl         String?
  whatsappTemplateBooking  String?
  whatsappTemplateReminder String?
  whatsappTemplateReview   String?
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
  branch                   Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchLandingContent {
  id             String   @id @default(uuid())
  branchId       String   @unique
  headline       String?
  subheadline    String?
  heroImageUrl   String?
  localCtaLabel  String?
  seoTitle       String?
  seoDescription String?
  testimonials   Json?
  faqEntries     Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cityContent    Json?
  branch         Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchPayoutRules {
  id                     String       @id @default(uuid())
  branchId               String       @unique
  baseRateType           BaseRateType
  baseRateValue          Decimal      @db.Decimal(10, 2)
  overtimeRules          Json?
  tipHandling            TipHandling
  franchiseFeePercentage Decimal?     @db.Decimal(5, 2)
  createdAt              DateTime     @default(now())
  updatedAt              DateTime     @updatedAt
  branch                 Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
}

model BranchSops {
  id        String      @id @default(uuid())
  branchId  String
  category  SopCategory
  title     String
  docUrl    String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  branch    Branch      @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([branchId, category])
}

model BranchOnboardingResources {
  id          String   @id @default(uuid())
  branchId    String
  name        String
  description String?
  resourceUrl String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  branch      Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
}

model Job {
  id                  String    @id @default(uuid())
  sessionId           String?   @unique
  branchId            String
  customerId          String?
  assignedCleanerId   String?
  customerName        String?
  preferredDate       DateTime?
  preferredTime       String?
  serviceType         String?
  serviceLocation     String?
  address             String?
  status              String    @default("pending")
  totalPrice          Decimal?  @db.Decimal(10, 2)
  createdAt           DateTime  @default(now())
  assignedAt          DateTime?
  onTheWayAt          DateTime?
  completedAt         DateTime?
  currency            String?   @default("USD")
  paymentMethod       String?
  jobQualityScore     Int?
  appliedReferralCode String?
  promoApplied        String?
  promoDiscount       Decimal?  @db.Decimal(10, 2)
  assignedCleaner     User?     @relation("AssignedJobs", fields: [assignedCleanerId], references: [id])
  branch              Branch    @relation(fields: [branchId], references: [id])
  customer            Customer? @relation(fields: [customerId], references: [id])

  @@index([branchId])
  @@index([assignedCleanerId])
  @@index([customerId])
  @@index([status])
  @@index([preferredDate])
  @@index([jobQualityScore])
  @@index([appliedReferralCode])
}

model CleanerApplication {
  id                  String                   @id @default(uuid())
  name                String
  email               String
  phone               String
  branchId            String
  experienceLevel     String?
  daysAvailable       Json?
  notes               String?
  status              CleanerApplicationStatus @default(PENDING)
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  applicantFitScore   Int?
  areaOfResidence     String?
  canTravelToVillas   Boolean                  @default(false)
  idUploadUrl         String?
  referencesUploadUrl String?
  weekendAbility      Boolean                  @default(false)
  whatsappNumber      String?
  branch              Branch                   @relation(fields: [branchId], references: [id])

  @@index([branchId])
  @@index([status])
  @@index([email])
  @@index([applicantFitScore])
}

model FranchiseApplication {
  id                      String                     @id @default(uuid())
  name                    String
  email                   String
  phone                   String
  city                    String
  state                   String
  country                 String
  desiredBranchSlug       String?
  background              String?
  investmentCapacityRange String?
  notes                   String?
  status                  FranchiseApplicationStatus @default(PENDING)
  internalNotes           String?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt

  @@index([status])
  @@index([email])
  @@index([city, state])
}

model VillaPartnerApplication {
  id                String   @id @default(cuid())
  propertyName      String
  managerName       String
  whatsapp          String
  bedrooms          Int
  bathrooms         Int
  turnoverFrequency String
  needsInventory    Boolean  @default(false)
  needsLinenService Boolean  @default(false)
  notes             String?
  status            String   @default("NEW")
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([status])
  @@index([createdAt])
}

model Contract {
  id        String    @id @default(cuid())
  name      String
  type      String
  branch    String    @default("port-antonio")
  url       String
  status    String    @default("PENDING")
  signedAt  DateTime?
  signedBy  String?
  phone     String?
  email     String?
  metadata  Json?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([type])
  @@index([status])
  @@index([branch])
  @@index([createdAt])
}

model JamaicaPayout {
  id            String   @id @default(cuid())
  cleanerId     String
  branchId      String
  periodStart   DateTime
  periodEnd     DateTime
  totalAmount   Float
  currency      String   @default("JMD")
  status        String   @default("PENDING")
  paymentMethod String   @default("BANK_TRANSFER")
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  cleaner       User     @relation("CleanerPayouts", fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([branchId])
  @@index([status])
  @@index([periodStart, periodEnd])
}

model TransactionLedger {
  id              String   @id @default(cuid())
  branchId        String?
  transactionType String
  amount          Float
  currency        String   @default("JMD")
  description     String?
  referenceId     String?
  referenceType   String?
  cleanerId       String?
  customerId      String?
  metadata        Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  branch          Branch?  @relation(fields: [branchId], references: [id])
  cleaner         User?    @relation(fields: [cleanerId], references: [id])

  @@index([branchId])
  @@index([cleanerId])
  @@index([customerId])
  @@index([transactionType])
  @@index([createdAt])
  @@index([referenceId, referenceType])
}

model JamaicaPaymentMethod {
  id             String   @id @default(cuid())
  cleanerId      String   @unique
  bankName       String?
  accountNumber  String?
  accountType    String?
  whatsappNumber String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  cleaner        User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
}

model TrainingModule {
  id          String           @id @default(cuid())
  slug        String           @unique
  title       String
  description String
  order       Int
  isActive    Boolean          @default(true)
  lessons     TrainingLesson[]

  @@index([slug])
  @@index([order])
  @@index([isActive])
}

model TrainingLesson {
  id         String           @id @default(cuid())
  moduleId   String
  title      String
  content    String
  order      Int
  quizJson   Json?
  progresses LessonProgress[]
  module     TrainingModule   @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  quiz       TrainingQuiz?

  @@index([moduleId])
  @@index([moduleId, order])
}

model LessonProgress {
  id          String         @id @default(cuid())
  cleanerId   String
  lessonId    String
  status      String         @default("NOT_STARTED")
  score       Int?
  completedAt DateTime?
  cleaner     User           @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  lesson      TrainingLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([cleanerId, lessonId])
  @@index([cleanerId])
  @@index([lessonId])
  @@index([status])
}

model TrainingStatus {
  id             String               @id @default(cuid())
  cleanerId      String               @unique
  overallStatus  String               @default("NOT_STARTED")
  lastModuleSlug String?
  updatedAt      DateTime             @updatedAt
  certificate    TrainingCertificate? @relation("TrainingStatusCertificate")
  cleaner        User                 @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([overallStatus])
}

model TrainingCertificate {
  id            String          @id @default(cuid())
  certificateId String          @unique
  cleanerId     String          @unique
  status        String          @default("ACTIVE")
  issuedAt      DateTime        @default(now())
  revokedAt     DateTime?
  cleaner       User            @relation("CleanerCertificate", fields: [cleanerId], references: [id], onDelete: Cascade, map: "TrainingCertificate_cleanerId_User_fkey")
  trainingStatus TrainingStatus? @relation("TrainingStatusCertificate", fields: [cleanerId], references: [cleanerId], onDelete: Cascade, map: "TrainingCertificate_cleanerId_TrainingStatus_fkey")

  @@index([certificateId])
  @@index([cleanerId])
  @@index([status])
}

model TrainingQuiz {
  id           String                @id @default(cuid())
  lessonId     String                @unique
  title        String
  passingScore Int                   @default(70)
  timeLimit    Int?
  isActive     Boolean               @default(true)
  questions    TrainingQuestion[]
  lesson       TrainingLesson        @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  attempts     TrainingQuizAttempt[]

  @@index([lessonId])
  @@index([isActive])
}

model TrainingQuestion {
  id            String       @id @default(cuid())
  quizId        String
  question      String
  order         Int
  questionType  String       @default("MULTIPLE_CHOICE")
  options       Json
  correctAnswer Int
  explanation   String?
  quiz          TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([quizId])
  @@index([quizId, order])
}

model TrainingQuizAttempt {
  id          String       @id @default(cuid())
  cleanerId   String
  quizId      String
  lessonId    String
  score       Int
  passed      Boolean
  answers     Json
  startedAt   DateTime     @default(now())
  completedAt DateTime?
  cleaner     User         @relation(fields: [cleanerId], references: [id], onDelete: Cascade)
  quiz        TrainingQuiz @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([quizId])
  @@index([lessonId])
  @@index([passed])
  @@index([startedAt])
}

model CleanerAvailability {
  id            String   @id @default(uuid())
  cleanerId     String   @unique
  workingDays   Json
  timeRanges    Json
  maxDailyJobs  Int      @default(3)
  blackoutDates Json?
  isActive      Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  cleaner       User     @relation(fields: [cleanerId], references: [id], onDelete: Cascade)

  @@index([cleanerId])
  @@index([isActive])
}

model ReferralLink {
  id              String           @id @default(uuid())
  customerId      String
  branchId        String
  code            String           @unique
  isActive        Boolean          @default(true)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  referralCredits ReferralCredit[]
  referralEvents  ReferralEvent[]
  branch          Branch           @relation("BranchReferralLinks", fields: [branchId], references: [id], onDelete: Cascade)
  customer        Customer         @relation("CustomerReferralLinks", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([branchId])
  @@index([code])
}

model ReferralCredit {
  id             String               @id @default(uuid())
  customerId     String
  referralLinkId String?
  amount         Decimal              @db.Decimal(10, 2)
  status         ReferralCreditStatus @default(PENDING)
  appliedToJobId String?
  expiresAt      DateTime?
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  customer       Customer             @relation("CustomerReferralCredits", fields: [customerId], references: [id], onDelete: Cascade)
  referralLink   ReferralLink?        @relation(fields: [referralLinkId], references: [id])

  @@index([customerId])
  @@index([status])
  @@index([referralLinkId])
}

model ReferralEvent {
  id                      String              @id @default(uuid())
  referrerId              String
  referredCustomerId      String
  branchId                String
  referralLinkId          String?
  jobId                   String?
  status                  ReferralEventStatus @default(PENDING)
  referrerCreditId        String?
  referredDiscountApplied Boolean             @default(false)
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt
  branch                  Branch              @relation("BranchReferralEvents", fields: [branchId], references: [id], onDelete: Cascade)
  referralLink            ReferralLink?       @relation(fields: [referralLinkId], references: [id])
  referredCustomer        Customer            @relation("ReferredCustomerEvents", fields: [referredCustomerId], references: [id], onDelete: Cascade)
  referrer                Customer            @relation("ReferrerEvents", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
  @@index([referredCustomerId])
  @@index([branchId])
  @@index([status])
  @@index([referralLinkId])
}

model NurtureSequence {
  id           String           @id @default(uuid())
  customerId   String           @unique
  branchId     String
  isActive     Boolean          @default(true)
  currentDay   Int              @default(0)
  startedAt    DateTime         @default(now())
  pausedAt     DateTime?
  completedAt  DateTime?
  referralCode String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  history      NurtureHistory[]
  branch       Branch           @relation(fields: [branchId], references: [id], onDelete: Cascade)
  customer     Customer         @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([branchId])
  @@index([isActive])
}

model NurtureHistory {
  id                String               @id @default(uuid())
  customerId        String
  nurtureSequenceId String?
  day               Int
  message           String
  channel           NurtureChannel
  status            NurtureMessageStatus @default(PENDING)
  messageId         String?
  sentAt            DateTime?
  errorMessage      String?
  createdAt         DateTime             @default(now())
  customer          Customer             @relation(fields: [customerId], references: [id], onDelete: Cascade)
  nurtureSequence   NurtureSequence?     @relation(fields: [nurtureSequenceId], references: [id], onDelete: Cascade)

  @@index([customerId])
  @@index([nurtureSequenceId])
  @@index([day])
  @@index([status])
}

model Promo {
  id            String   @id @default(cuid())
  branchId      String
  month         Int
  year          Int
  title         String
  description   String
  discountType  String
  discountValue Int
  active        Boolean  @default(true)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([branchId, month, year])
  @@index([branchId])
  @@index([active])
  @@index([startDate, endDate])
  @@index([month, year])
}

model Lead {
  id                String     @id @default(cuid())
  branchId          String
  name              String
  phone             String
  email             String?
  zip               String?
  bedrooms          Int?
  bathrooms         Int?
  pets              Boolean    @default(false)
  homeType          String?
  urgency           String?
  previousService   Boolean    @default(false)
  referralSource    String?
  leadScore         Int        @default(0)
  leadTier          String     @default("C")
  riskFlags         String[]   @default([])
  status            LeadStatus @default(NEW)
  depositPaid       Boolean    @default(false)
  depositUrl        String?
  customerId        String?
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  afterHoursMessage String?
  waitForMorning    Boolean    @default(false)
  branch            Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@index([branchId])
  @@index([status])
  @@index([leadTier])
  @@index([leadScore])
  @@index([phone])
  @@index([email])
  @@index([zip])
  @@index([waitForMorning])
}

enum UserRole {
  ADMIN
  MANAGER
  CLEANER
  SUPPORT
}

enum BranchStatus {
  ACTIVE
  COMING_SOON
  PAUSED
}

enum BillingType {
  HOURLY
  FLAT
  TIERED
}

enum BaseRateType {
  PER_HOUR
  PER_JOB
  PERCENTAGE
}

enum TipHandling {
  PASS_THROUGH
  SPLIT
  POOL
}

enum SopCategory {
  OPS
  SALES
  QC
  COMPLIANCE
}

enum CleanerApplicationStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FranchiseApplicationStatus {
  PENDING
  REVIEWED
  APPROVED
  REJECTED
}

enum ReferralCreditStatus {
  PENDING
  APPLIED
  EXPIRED
  CANCELLED
}

enum ReferralEventStatus {
  PENDING
  COMPLETED
  CANCELLED
}

enum LeadStatus {
  NEW
  ACTIVE
  BOOKED
  CLOSED
  QUALIFIED
  REJECTED
}

enum NurtureChannel {
  WHATSAPP
  SMS
}

enum NurtureMessageStatus {
  PENDING
  SENT
  FAILED
  STOPPED
}
