model InvestorAccessRequest {
  id           String                @id @default(cuid())
  name         String
  email        String
  organization String?
  interest     String?
  status       InvestorAccessStatus  @default(PENDING)
  approvedAt   DateTime?
  approvedBy   String?
  createdAt    DateTime              @default(now())
}

model ContactMessage {
  id           String                @id @default(cuid())
  role         String
  name         String
  email        String
  organization String?
  message      String?
  status       ContactMessageStatus @default(NEW)
  tenantId     String?
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  reviewedAt   DateTime?
  repliedAt   DateTime?
  archivedAt   DateTime?

  replies      ContactReply[]
  internalNotes ContactInternalNote[]
  Tenant       Tenant?               @relation(fields: [tenantId], references: [id])

  @@index([tenantId])
}

model ContactReply {
  id               String   @id @default(cuid())
  contactMessageId String
  body             String
  repliedByAdminId String?
  sentViaEmail     Boolean  @default(true)
  createdAt        DateTime @default(now())

  contactMessage ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
}

model ContactReplyTemplate {
  id        String   @id @default(cuid())
  title     String
  role      String   // Investor | Partner / Operator | Advisor | Other | All
  body      String
  createdAt DateTime @default(now())
}

model ContactInternalNote {
  id               String   @id @default(cuid())
  contactMessageId String
  body             String
  createdAt        DateTime @default(now())

  contactMessage ContactMessage @relation(fields: [contactMessageId], references: [id], onDelete: Cascade)
}

