// Phase L: Pricing Tables
model ServiceType {
  id          String   @id @default(cuid())
  code        String   @unique  // "STANDARD", "DEEP", "MOVE_OUT", "RECURRING"
  name        String
  description String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
  
  ServicePricing ServicePricing[]
  
  @@index([code])
  @@index([isActive])
}

model ServicePricing {
  id              String      @id @default(cuid())
  serviceTypeId   String
  branchId        String?
  basePrice       Decimal     @db.Decimal(10, 2)
  hourlyRate      Decimal?    @db.Decimal(10, 2)
  currency        String      @default("USD")
  effectiveFrom   DateTime    @default(now())
  effectiveTo     DateTime?
  isActive        Boolean     @default(true)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime
  
  ServiceType     ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)
  Branch          Branch?     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  // Job             Job[]  // Removed - pricingReferenceId not in database
  
  @@index([serviceTypeId])
  @@index([branchId])
  @@index([isActive])
  @@index([effectiveFrom, effectiveTo])
}

model RegionPricingModifier {
  id              String   @id @default(cuid())
  branchId        String
  regionType      String   // "CITY", "ZIP", "STATE"
  regionValue     String   // City name, ZIP code, or state code
  modifierPercent Decimal  @db.Decimal(5, 2)  // e.g., 10.00 = +10%, -5.00 = -5%
  isActive        Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
  
  Branch          Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  
  @@unique([branchId, regionType, regionValue])
  @@index([branchId])
  @@index([isActive])
  @@index([regionType, regionValue])
}
