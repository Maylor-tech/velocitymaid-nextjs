# Copy to .env.local for deposit E2E testing (never commit real keys)
# Stripe Dashboard → Developers → Test mode

BOOKING_PAYMENT_MODE=deposit
BOOKING_DEPOSIT_CENTS=2500
NEXT_PUBLIC_BOOKING_PAYMENT_MODE=deposit
NEXT_PUBLIC_BOOKING_DEPOSIT_DOLLARS=25

# Required: TEST keys only (sk_test_ / pk_test_)
STRIPE_SECRET_KEY=sk_test_your_test_secret_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_test_publishable_key

# From: stripe listen --forward-to localhost:3000/api/webhooks/stripe
STRIPE_WEBHOOK_SECRET=whsec_your_local_webhook_secret

# Use http://localhost:3000 for local runs
NEXT_PUBLIC_BASE_URL=http://localhost:3000
